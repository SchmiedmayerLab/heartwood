{
  "name": "@heartwood/webui",
  "version": "0.3.0-beta.3",
  "private": true,
  "type": "module",
  "description": "Researcher web UI for Heartwood sessions.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "contracts:check": "node scripts/generate-api-types.mjs --check",
    "contracts:generate": "node scripts/generate-api-types.mjs",
    "dev": "vite --host 127.0.0.1",
    "duplicates:check": "jscpd --config ../../.jscpd.json --no-colors --no-tips ../../packages/*/src",
    "format:check": "prettier --check .",
    "license:check": "node scripts/check-licenses.mjs",
    "lint": "eslint .",
    "preview": "vite preview --host 127.0.0.1",
    "screenshots:docs": "npm run build && node scripts/smoke-reference-analysis.cjs --screenshot-dir ../../documentation/assets/screenshots",
    "test": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:gateway": "node scripts/smoke-gateway.cjs",
    "test:jupyter-proxy": "node scripts/smoke-jupyter-proxy.cjs",
    "test:reference-analysis": "node scripts/smoke-reference-analysis.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/language-data": "6.5.2",
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.7.1",
    "@stanfordspezi/spezi-web-design-system": "0.20.0",
    "@tanstack/react-query": "5.101.4",
    "codemirror": "6.0.2",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "unist-util-visit": "5.1.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "brace-expansion@1.1.16": "1.1.18",
    "esbuild": "0.28.1",
    "next": "16.2.11",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@stanfordspezi/spezi-web-configurations": "0.7.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/mdast": "4.0.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "jscpd": "5.0.14",
    "jsdom": "30.0.0",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
