+                sandbox_record("sb-c", "sandbox-c", SandboxPhase::Provisioning),
+                None,
+                false,
+            )
+            .await
+            .unwrap();
+        assert_eq!(driver.create_calls.load(Ordering::SeqCst), 1);
+    }
