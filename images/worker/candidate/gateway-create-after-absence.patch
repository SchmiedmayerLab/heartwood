+    async fn look_up_name(&self, workspace: &str, name: &str) -> Result<Option<Sandbox>, Status> {
+        let read = || async {
+            self.store
+                .get_message_by_name::<Sandbox>(workspace, name)
+                .await
+                .map_err(|e| Status::internal(format!("fetch sandbox failed: {e}")))
+        };
+        if let Some(candidate) = read().await? {
+            return Ok(Some(candidate));
+        }
+        // Creation rejects a longer name before it persists anything, so
+        // the absence of such a name needs no record.
+        if name.len() > crate::grpc::MAX_ROUTABLE_NAME_LEN {
+            return Ok(None);
+        }
+        // Record the absence, then read again. A creation that persisted
+        // first is found here; a later one is rejected by its check.
+        let written = self.record_confirmed_absent_name(workspace, name).await?;
+        #[cfg(test)]
+        {
+            if let Ok((reached, resume)) = ABSENCE_RECORDED.try_with(Clone::clone) {
+                reached.notify_one();
+                resume.notified().await;
+            }
+        }
+        let candidate = read().await?;
+        if candidate.is_some()
+            && let Some(written) = written
+        {
+            // This deletion answers for the sandbox it found, never with
+            // absence, so its write backs no answer.
+            self.withdraw_absence_write(workspace, name, &written).await;
+        }
+        Ok(candidate)
+    }
+
+    /// Inserts the record or renews it in place, and returns the write. A
+    /// renewal keeps the record's id, and an undo is conditional on this
+    /// write's version, so it never touches a write of another deletion.
+    /// Under persistent contention it falls back to an upsert that is never
+    /// undone, which keeps the name rejected until the record expires.
+    async fn record_confirmed_absent_name(
+        &self,
+        workspace: &str,
+        name: &str,
+    ) -> Result<Option<AbsenceWrite>, Status> {
+        let failed = |e| Status::internal(format!("record sandbox absence failed: {e}"));
+        for _ in 0..CONFIRMED_ABSENT_NAME_WRITE_ATTEMPTS {
+            let existing = self
+                .store
+                .get_by_name(CONFIRMED_ABSENT_NAME_OBJECT_TYPE, workspace, name)
+                .await
+                .map_err(failed)?;
+            let (id, condition, renewed_from_ms) = match existing {
+                None => (
+                    uuid::Uuid::new_v4().to_string(),
+                    WriteCondition::MustCreate,
+                    None,
+                ),
+                Some(existing) => (
+                    existing.id.clone(),
+                    WriteCondition::MatchResourceVersion(existing.resource_version),
+                    Some(AbsenceRecordPayload::recorded_at_ms(&existing)),
+                ),
+            };
+            // A renewal on a gateway whose clock runs behind must not move
+            // the retention start back past the answers it extends.
+            let payload = match renewed_from_ms {
+                Some(previous) => serde_json::to_vec(&AbsenceRecordPayload {
+                    recorded_at_ms: Some(crate::persistence::current_time_ms().max(previous)),
+                })
+                .map_err(|e| Status::internal(format!("encode sandbox absence record: {e}")))?,
+                None => Vec::new(),
+            };
+            match self
+                .store
+                .put_if(
+                    CONFIRMED_ABSENT_NAME_OBJECT_TYPE,
+                    &id,
+                    name,
+                    workspace,
+                    &payload,
+                    None,
+                    condition,
+                )
+                .await
+            {
+                Ok(written) => {
+                    return Ok(Some(AbsenceWrite {
+                        id,
+                        resource_version: written.resource_version,
+                        renewed_from_ms,
+                    }));
+                }
+                Err(
+                    crate::persistence::PersistenceError::Conflict { .. }
+                    | crate::persistence::PersistenceError::UniqueViolation { .. },
+                ) => {
+                    // Random backoff spreads concurrent deletions of one name.
+                    let jitter = uuid::Uuid::new_v4().as_u128() % 10;
+                    tokio::time::sleep(Duration::from_millis(1 + jitter as u64)).await;
+                }
+                Err(error) => return Err(failed(error)),
+            }
+        }
+        self.store
+            .put_if(
+                CONFIRMED_ABSENT_NAME_OBJECT_TYPE,
+                &uuid::Uuid::new_v4().to_string(),
+                name,
+                workspace,
+                &[],
+                None,
+                WriteCondition::Unconditional,
+            )
+            .await
+            .map_err(failed)?;
+        Ok(None)
+    }
+
+    /// Undoes one write: removes an inserted record, or restores the
+    /// retention start a renewal replaced. Conditional on the write's
+    /// version, so a later write of another deletion stays in force.
+    async fn withdraw_absence_write(&self, workspace: &str, name: &str, written: &AbsenceWrite) {
+        let payload = written.renewed_from_ms.map(|recorded_at_ms| {
+            serde_json::to_vec(&AbsenceRecordPayload {
+                recorded_at_ms: Some(recorded_at_ms),
+            })
+            .unwrap_or_default()
+        });
+        let mut attempts = 0;
+        loop {
+            let result = match &payload {
+                None => self
+                    .store
+                    .delete_if(
+                        CONFIRMED_ABSENT_NAME_OBJECT_TYPE,
+                        &written.id,
+                        written.resource_version,
+                    )
+                    .await
+                    .map(drop),
+                Some(payload) => self
+                    .store
+                    .put_if(
+                        CONFIRMED_ABSENT_NAME_OBJECT_TYPE,
+                        &written.id,
+                        name,
+                        workspace,
+                        payload,
+                        None,
+                        WriteCondition::MatchResourceVersion(written.resource_version),
+                    )
+                    .await
+                    .map(drop),
+            };
+            match result {
+                // On a conflict another deletion wrote the record since.
+                Ok(()) | Err(crate::persistence::PersistenceError::Conflict { .. }) => return,
+                Err(error) if attempts < 2 => {
+                    debug!(%error, workspace, name, "Retrying withdrawal of sandbox absence record");
+                    attempts += 1;
+                    tokio::time::sleep(Duration::from_millis(100 << attempts)).await;
+                }
+                Err(error) => {
+                    // The record stays and keeps the name rejected until it expires.
+                    warn!(%error, workspace, name, "Failed to withdraw sandbox absence record");
+                    return;
+                }
+            }
+        }
+    }
+
+    async fn ensure_name_not_confirmed_absent(
+        &self,
+        workspace: &str,
+        name: &str,
+    ) -> Result<(), Status> {
+        let record = self
+            .store
+            .get_by_name(CONFIRMED_ABSENT_NAME_OBJECT_TYPE, workspace, name)
+            .await
+            .map_err(|e| Status::internal(format!("fetch sandbox absence record failed: {e}")))?;
+        let retained = record.is_some_and(|record| {
+            confirmed_absent_name_retained(
+                AbsenceRecordPayload::recorded_at_ms(&record),
+                crate::persistence::current_time_ms(),
+            )
+        });
+        if retained {
+            return Err(confirmed_absent_name_rejection(name));
+        }
+        Ok(())
+    }
+
+    /// Refuses to start a never dispatched sandbox under a retained record.
+    async fn ensure_not_rejected_creation(&self, sandbox: &Sandbox) -> Result<(), Status> {
+        let failed = |e| Status::internal(format!("fetch sandbox absence record failed: {e}"));
+        let Some(absence) = self
+            .store
+            .get_by_name(
+                CONFIRMED_ABSENT_NAME_OBJECT_TYPE,
+                sandbox.object_workspace(),
+                sandbox.object_name(),
+            )
+            .await
+            .map_err(failed)?
+        else {
+            return Ok(());
+        };
+        // Without comparing timestamps of different replicas: a sandbox that
+        // passed its check only meets a later record of a deletion that
+        // found it, and then stays unstartable until the record expires.
+        let retained = confirmed_absent_name_retained(
+            AbsenceRecordPayload::recorded_at_ms(&absence),
+            crate::persistence::current_time_ms(),
+        );
+        if retained && never_dispatched(sandbox) {
+            return Err(confirmed_absent_name_rejection(sandbox.object_name()));
+        }
+        Ok(())
+    }
