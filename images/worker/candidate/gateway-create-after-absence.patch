+    async fn record_confirmed_absent_name(
+        &self,
+        workspace: &str,
+        name: &str,
+    ) -> Result<(), Status> {
+        // An upsert by workspace and name: a repeated deletion renews the record.
+        self.store
+            .put_if(
+                CONFIRMED_ABSENT_NAME_OBJECT_TYPE,
+                &uuid::Uuid::new_v4().to_string(),
+                name,
+                workspace,
+                &[],
+                None,
+                WriteCondition::Unconditional,
+            )
+            .await
+            .map(|_| ())
+            .map_err(|e| Status::internal(format!("record sandbox absence failed: {e}")))
+    }
+
+    async fn ensure_name_not_confirmed_absent(
+        &self,
+        workspace: &str,
+        name: &str,
+    ) -> Result<(), Status> {
+        let record = self
+            .store
+            .get_by_name(CONFIRMED_ABSENT_NAME_OBJECT_TYPE, workspace, name)
+            .await
+            .map_err(|e| Status::internal(format!("fetch sandbox absence record failed: {e}")))?;
+        let retained = record.is_some_and(|record| {
+            confirmed_absent_name_retained(
+                record.updated_at_ms,
+                crate::persistence::current_time_ms(),
+            )
+        });
+        if retained {
+            return Err(openshell_core::rpc_error::failed_precondition(
+                "SANDBOX_NAME_CONFIRMED_ABSENT",
+                format!(
+                    "sandbox name '{name}' was confirmed absent to a deletion; \
+                     create the sandbox under another name"
+                ),
+            ));
+        }
+        Ok(())
+    }
