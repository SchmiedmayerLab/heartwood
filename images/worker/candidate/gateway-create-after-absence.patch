+    /// Runs `during` while a deletion of `sandbox-a` waits between its
+    /// absence record and its second read of the name.
+    async fn delete_with_pause_after_absence_record(
+        runtime: &ComputeRuntime,
+        during: impl Future<Output = ()>,
+    ) -> Result<DeleteSandboxResult, Status> {
+        let recorded = Arc::new(Notify::new());
+        let resume = Arc::new(Notify::new());
+        let deletion = ABSENCE_RECORDED.scope(
+            (recorded.clone(), resume.clone()),
+            runtime.delete_sandbox_allow_missing("default", "sandbox-a", true),
+        );
+        let (result, ()) = tokio::join!(deletion, async {
+            tokio::time::timeout(Duration::from_secs(10), recorded.notified())
+                .await
+                .expect("the deletion records an absence");
+            during.await;
+            resume.notify_one();
+        });
+        result
+    }
