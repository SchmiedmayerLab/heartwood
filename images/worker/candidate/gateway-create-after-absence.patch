+    /// Renews the record behind a replayed `ALREADY_ABSENT`, as a new
+    /// deletion would. Returns false when a sandbox has the name now.
+    pub(crate) async fn renew_replayed_absence(
+        &self,
+        workspace: &str,
+        name: &str,
