+/// A never dispatched sandbox that persisted after the retention start of
+/// an absence record under its name, which stays retained beyond `margin_ms`,
+/// is a creation that its own check rejects. A crash before the check can
+/// leave it behind. A record keeps its id and its retention start never
+/// moves back past a write it backs, so the record existed since then.
+fn rejected_creation(
+    absence: &ObjectRecord,
+    sandbox: &ObjectRecord,
+    now_ms: i64,
+    margin_ms: i64,
+) -> bool {
+    let recorded_at_ms = AbsenceRecordPayload::recorded_at_ms(absence);
+    Sandbox::decode(sandbox.payload.as_slice()).is_ok_and(|decoded| never_dispatched(&decoded))
+        && sandbox.created_at_ms >= recorded_at_ms
+        && confirmed_absent_name_retained(recorded_at_ms, now_ms.saturating_add(margin_ms))
+}
