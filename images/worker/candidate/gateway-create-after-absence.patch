+    /// Returns the sandbox under the name, or none when no sandbox has it
+    /// and no later creation under it can reach the driver. Runs detached,
+    /// so that a cancelled request still undoes a record it does not need.
+    async fn look_up_name_for_deletion(
+        &self,
+        workspace: &str,
+        name: &str,
+    ) -> Result<Option<Sandbox>, Status> {
+        let runtime = self.clone();
+        let (workspace, name) = (workspace.to_string(), name.to_string());
+        let lookup = async move { runtime.look_up_name(&workspace, &name).await };
+        #[cfg(test)]
+        let lookup = {
+            let hook = ABSENCE_RECORDED.try_with(Clone::clone).ok();
+            async move {
+                match hook {
+                    Some(hook) => ABSENCE_RECORDED.scope(hook, lookup).await,
+                    None => lookup.await,
+                }
+            }
+        };
+        tokio::spawn(Box::pin(lookup).instrument(tracing::Span::current()))
+            .await
+            .map_err(|err| Status::internal(format!("sandbox name lookup failed: {err}")))?
+    }
