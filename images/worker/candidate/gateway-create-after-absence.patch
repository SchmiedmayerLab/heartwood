+    /// A never dispatched sandbox whose preparation deadline expired and
+    /// whose timeout cleanup finished, which makes it startable.
+    fn timed_out_leftover(id: &str, name: &str) -> Sandbox {
+        let mut leftover = undispatched_sandbox(id, name);
+        let now =
+            openshell_core::time::timestamp_from_millis(crate::persistence::current_time_ms());
+        let status = leftover.status.as_mut().unwrap();
+        status.phase = SandboxPhase::Error as i32;
+        let provisioning = status.provisioning.as_mut().unwrap();
+        provisioning.timeout_time = now.ok();
+        provisioning.cleanup_completed_time = now.ok();
+        leftover
+    }
