+/// Whether a sandbox was never sent to the driver.
+fn never_dispatched(sandbox: &Sandbox) -> bool {
+    sandbox
+        .status
+        .as_ref()
+        .and_then(|status| status.provisioning.as_ref())
+        .is_some_and(|record| {
+            record.driver_operation_id.is_empty() && !record.driver_operation_pending
+        })
