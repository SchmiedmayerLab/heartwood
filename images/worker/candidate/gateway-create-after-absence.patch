+    #[tokio::test]
+    async fn delete_of_an_absent_name_rejects_its_later_creation() {
+        let driver = ControlledDriver::new();
+        // The driver never created the rejected sandbox, so it reports it absent.
+        driver.set_delete_outcome(ControlledDeleteOutcome::Ok(false));
+        let runtime = test_runtime(driver.clone()).await;
+
+        let absent = runtime
