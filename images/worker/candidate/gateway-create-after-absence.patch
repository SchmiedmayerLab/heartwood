+    /// Visits one batch of absence records after `cursor` and wraps around
+    /// at the end. Removes expired records and deletes creations that their
+    /// own check rejects.
+    async fn sweep_confirmed_absent_names(
+        &self,
+        cursor: &mut Option<ObjectCursor>,
+    ) -> Result<(), String> {
+        let page = self
+            .store
+            .list_by_type_after(
+                CONFIRMED_ABSENT_NAME_OBJECT_TYPE,
+                cursor.as_ref(),
+                CONFIRMED_ABSENT_NAME_SWEEP_BATCH,
+            )
+            .await
+            .map_err(|e| e.to_string())?;
+        let last_page = page.len() < CONFIRMED_ABSENT_NAME_SWEEP_BATCH as usize;
+        for record in page {
+            *cursor = Some(ObjectCursor::from(&record));
+            let now_ms = crate::persistence::current_time_ms();
+            let recorded_at_ms = AbsenceRecordPayload::recorded_at_ms(&record);
+            if !confirmed_absent_name_retained(recorded_at_ms, now_ms) {
+                match self
+                    .store
+                    .delete_if(
+                        CONFIRMED_ABSENT_NAME_OBJECT_TYPE,
+                        &record.id,
+                        record.resource_version,
+                    )
+                    .await
+                {
+                    Ok(_) | Err(crate::persistence::PersistenceError::Conflict { .. }) => {}
+                    Err(error) => return Err(error.to_string()),
+                }
+                continue;
+            }
+            let Some(sandbox) = self
+                .store
+                .get_by_name(Sandbox::object_type(), &record.workspace, &record.name)
+                .await
+                .map_err(|e| e.to_string())?
+            else {
+                continue;
+            };
+            if !rejected_creation(
+                &record,
+                &sandbox,
+                now_ms,
+                CONFIRMED_ABSENT_NAME_CLOCK_MARGIN_MS,
+            ) {
+                continue;
+            }
+            let target = SandboxDeleteTarget {
+                sandbox_id: sandbox.id.clone(),
+                sandbox_name: sandbox.name.clone(),
+            };
+            let preconditions = SandboxDeletePreconditions {
+                expected_sandbox_id: Some(sandbox.id.clone()),
+                expected_resource_version: Some(sandbox.resource_version),
+            };
+            info!(sandbox_id = %sandbox.id, "Deleting a creation rejected by its absence check");
+            let deleted = Box::pin(self.delete_sandbox_target(target, preconditions)).await;
+            if let Err(status) = deleted {
+                warn!(sandbox_id = %sandbox.id, error = %status.message(),
+                    "Failed to delete a creation rejected by its absence check");
+            }
+        }
+        if last_page {
+            *cursor = None;
+        }
+        Ok(())
+    }
