+            .await
+            .unwrap();
+        assert_eq!(
+            absent.outcome,
+            openshell_core::proto::DeletionOutcome::AlreadyAbsent
+        );
+        let missing = runtime
+            .delete_sandbox_allow_missing("default", "sandbox-b", false)
+            .await
+            .unwrap_err();
+        assert_eq!(missing.code(), Code::NotFound);
+
+        for (id, name) in [("sb-a", "sandbox-a"), ("sb-b", "sandbox-b")] {
+            let rejected = runtime
+                .create_sandbox(
+                    sandbox_record(id, name, SandboxPhase::Provisioning),
+                    None,
+                    false,
+                )
+                .await
+                .unwrap_err();
+            assert_eq!(rejected.code(), Code::FailedPrecondition);
+            assert!(rejected.message().contains("confirmed absent"));
+            assert!(
+                runtime
+                    .store
+                    .get_message_by_name::<Sandbox>("default", name)
+                    .await
+                    .unwrap()
+                    .is_none()
+            );
+        }
+        assert_eq!(driver.create_calls.load(Ordering::SeqCst), 0);
+
+        // Other names are unaffected.
