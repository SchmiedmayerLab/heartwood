+    from openhands.sdk.llm.exceptions.classifier import is_quota_exhaustion_error
+
+    if is_quota_exhaustion_error(error):
+        return _failure(FailureKind.QUOTA, user_action="settings")
+    return _failure(FailureKind.RATE_LIMIT, retryable=True, user_action="retry")
+
+
+def classify_exception(error: BaseException) -> ErrorClassification:
+    """Classify a live exception before provider metadata is discarded."""
+    from openai import RateLimitError
+
+    from openhands.sdk.llm.exceptions.types import LLMRateLimitError
+
+    if isinstance(error, (RateLimitError, LLMRateLimitError)):
+        return _rate_limit_failure(error)
+    return classify_error(type(error).__name__, str(error))
 
 
