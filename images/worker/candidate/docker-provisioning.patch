+
+#[tokio::test]
+async fn deletion_keeps_pending_provisioning_owned_until_settled() {
+    let driver = test_driver_with_config(runtime_config());
+    let sandbox = test_sandbox();
+    driver.reserve_pending_sandbox(&sandbox).await.unwrap();
+
+    // Also covers deletion between reservation and task registration.
+    let error = driver
+        .delete_sandbox_inner(&sandbox.id, &sandbox.name)
+        .await
+        .unwrap_err();
+    assert_eq!(error.code(), tonic::Code::FailedPrecondition);
+    assert!(
+        driver
+            .pending_snapshot(&sandbox.id, &sandbox.name)
+            .await
+            .unwrap()
+            .is_some()
+    );
+
+    let (release, waiting) = oneshot::channel();
+    let (completed, completion) = oneshot::channel();
+    let task = tokio::spawn(async move {
+        waiting.await.unwrap();
+        completed.send(()).unwrap();
+    });
+    driver
+        .pending
+        .lock()
+        .await
+        .get_mut(&sandbox.id)
+        .unwrap()
+        .task = Some(task);
+    let error = driver
+        .delete_sandbox_inner(&sandbox.id, &sandbox.name)
+        .await
+        .unwrap_err();
+    assert_eq!(error.code(), tonic::Code::FailedPrecondition);
+    release.send(()).unwrap();
+    completion.await.unwrap();
+
+    driver
+        .fail_pending_sandbox(
+            &sandbox,
+            &DockerProvisioningFailure::new("ContainerCreateFailed", "synthetic settled failure"),
+        )
+        .await;
+    assert!(
+        driver
+            .remove_pending_sandbox(&sandbox.id, &sandbox.name, true)
+            .await
+            .unwrap()
+            .is_some()
+    );
+    assert!(
+        driver
+            .pending_snapshot(&sandbox.id, &sandbox.name)
+            .await
+            .unwrap()
+            .is_none()
+    );
+}
