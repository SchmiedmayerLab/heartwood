+@pytest.mark.parametrize(
+    "state",
+    [
+        openshell_pb2.CONFIGURATION_ADMISSION_STATE_PENDING,
+        openshell_pb2.CONFIGURATION_ADMISSION_STATE_ACCEPTED,
+        openshell_pb2.CONFIGURATION_ADMISSION_STATE_REJECTED,
+    ],
+)
+def test_get_preserves_configuration_admission(state: int) -> None:
+    activated = state == openshell_pb2.CONFIGURATION_ADMISSION_STATE_ACCEPTED
+    error = (
+        "Synthetic admission failure"
+        if state == openshell_pb2.CONFIGURATION_ADMISSION_STATE_REJECTED
+        else ""
+    )
+    proto = _make_sandbox_proto("sandbox-1", "job-1")
+    proto.status.configuration_admission.CopyFrom(
+        openshell_pb2.SandboxConfigurationAdmission(
+            state=cast("openshell_pb2.ConfigurationAdmissionState", state),
+            policy_version=7,
+            policy_hash="a" * 64,
+            config_revision=9,
+            provider_env_revision=4,
+            error=error,
+        )
+    )
+    proto.status.configuration_activated = activated
+    client = _client_with_fake_stub(
+        SimpleNamespace(
+            GetSandbox=lambda *_args, **_kwargs: SimpleNamespace(sandbox=proto)
+        )
+    )
+
+    status = client.get("job-1", workspace="default").status
+
+    assert status.configuration_activated == activated
+    admission = status.configuration_admission
+    assert isinstance(admission, SandboxConfigurationAdmissionRef)
+    assert asdict(admission) == {
+        "state": state,
+        "policy_version": 7,
+        "policy_hash": "a" * 64,
+        "config_revision": 9,
+        "provider_env_revision": 4,
+        "error": error,
+    }
+    proto.status.configuration_admission.config_revision = 10
+    assert admission.config_revision == 9
+
+
+@pytest.mark.parametrize("has_status", [False, True])
+def test_missing_configuration_admission_is_not_an_accepted_configuration(
+    has_status: bool,
+) -> None:
+    proto = _make_sandbox_proto("sandbox-1", "job-1")
+    if not has_status:
+        proto.ClearField("status")
+    status = _sandbox_ref(proto).status
+
+    assert status.configuration_admission is None
+    assert not status.configuration_activated
+
+
+def test_get_preserves_main_process_identity_across_restart() -> None:
+    proto = _make_sandbox_proto("sandbox-1", "job-1")
+    proto.status.main_process_instance_id = "process-1"
+    client = _client_with_fake_stub(
+        SimpleNamespace(
+            GetSandbox=lambda *_args, **_kwargs: SimpleNamespace(sandbox=proto)
+        )
+    )
+    first = client.get("job-1", workspace="default")
+    proto.status.main_process_instance_id = "process-2"
+    second = client.get("job-1", workspace="default")
+
+    assert first.id == second.id
+    assert first.status.main_process_instance_id == "process-1"
+    assert second.status.main_process_instance_id == "process-2"
+
+
+@pytest.mark.parametrize("has_status", [False, True])
+def test_missing_main_process_identity_is_not_inferred(has_status: bool) -> None:
+    proto = _make_sandbox_proto("sandbox-1", "job-1")
+    if not has_status:
+        proto.ClearField("status")
+
+    assert _sandbox_ref(proto).status.main_process_instance_id is None
+
