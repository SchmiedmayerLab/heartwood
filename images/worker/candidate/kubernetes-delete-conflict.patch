+    fn sandbox_delete_steps(response: http::Response<kube::client::Body>) -> Vec<KubeTestStep> {
+        vec![
+            (
+                http::Method::GET,
+                "/apis/agents.x-k8s.io/v1beta1/namespaces/openshell/sandboxes",
+                kube_test_response(
+                    http::StatusCode::OK,
+                    serde_json::json!({
+                        "apiVersion": "agents.x-k8s.io/v1beta1",
+                        "kind": "SandboxList",
+                        "items": [{
+                            "apiVersion": "agents.x-k8s.io/v1beta1",
+                            "kind": "Sandbox",
+                            "metadata": {
+                                "name": "sandbox-cr",
+                                "namespace": "openshell",
+                                "uid": "sandbox-uid",
+                                "resourceVersion": "41"
+                            }
+                        }]
+                    }),
+                ),
+            ),
+            (
+                http::Method::DELETE,
+                "/apis/agents.x-k8s.io/v1beta1/namespaces/openshell/sandboxes/sandbox-cr",
+                response,
+            ),
+        ]
+    }
+
+    #[tokio::test]
+    async fn delete_reports_a_conflict_as_an_error_not_as_absence() {
+        let (driver, steps, bodies) = scripted_driver(
+            KubernetesComputeConfig::default(),
+            sandbox_delete_steps(kube_test_response(
+                http::StatusCode::CONFLICT,
+                serde_json::json!({
+                    "apiVersion": "v1",
+                    "kind": "Status",
+                    "status": "Failure",
+                    "message": "the object has been modified",
+                    "reason": "Conflict",
+                    "code": 409
+                }),
+            )),
+        );
+        driver
+            .sandbox_api_version
+            .set(SANDBOX_VERSION_V1BETA1)
+            .expect("set test Sandbox API version");
+
+        let error = driver
+            .delete_sandbox("sandbox-1")
+            .await
+            .expect_err("a conflicting delete must not report absence");
+
+        assert!(error.contains("retry deletion"), "{error}");
+        assert!(steps.lock().unwrap().is_empty());
+        // The conflict is only meaningful because the delete is conditional.
+        assert_eq!(
+            bodies.lock().unwrap()[0]["preconditions"],
+            serde_json::json!({"resourceVersion": "41", "uid": "sandbox-uid"})
+        );
+    }
+
+    #[tokio::test]
+    async fn delete_reports_a_missing_sandbox_as_absent() {
+        let (driver, steps, _) = scripted_driver(
+            KubernetesComputeConfig::default(),
+            sandbox_delete_steps(kube_test_not_found("sandboxes", "sandbox-cr")),
+        );
+        driver
+            .sandbox_api_version
+            .set(SANDBOX_VERSION_V1BETA1)
+            .expect("set test Sandbox API version");
+
+        assert_eq!(driver.delete_sandbox("sandbox-1").await, Ok(false));
+        assert!(steps.lock().unwrap().is_empty());
+    }
