+++ b/tests/tools/terminal/test_terminal_environment_selection.py
@@ -0,0 +1,180 @@
+"""Explicit terminal environments exclude inherited values across lifecycle paths."""
+
+import shutil
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+
+from openhands.tools.terminal.definition import TerminalAction, TerminalTool
+from openhands.tools.terminal.env import build_terminal_env
+from openhands.tools.terminal.impl import TerminalExecutor
+from openhands.tools.terminal.terminal import factory
+from openhands.tools.terminal.terminal.tmux_terminal import _new_owned_session
+from openhands.tools.terminal.terminal.windows_terminal import WindowsTerminal
+
+
+@pytest.mark.parametrize("inherit", [False, True])
+def test_environment_selection_preserves_default(monkeypatch, inherit):
+    monkeypatch.setenv("TERMINAL_TEST_SECRET", "synthetic")
+    selected = build_terminal_env(
+        {"PATH": "/usr/bin:/bin"}, inherit_environment=inherit
+    )
+    assert ("TERMINAL_TEST_SECRET" in selected) is inherit
+    assert selected["PATH"] == "/usr/bin:/bin"
+
+
+def test_terminal_subprocess_and_reset_exclude_inherited_tokens(tmp_path, monkeypatch):
+    tokens = [
+        "AWS_SECRET_ACCESS_KEY",
+        "GITHUB_TOKEN",
+        "HF_TOKEN",
+        "JUPYTERHUB_API_TOKEN",
+    ]
+    for key in tokens:
+        monkeypatch.setenv(key, "synthetic")
+    # The reset may select tmux when available; both modes must preserve the setting.
+    executor = TerminalExecutor(
+        str(tmp_path),
+        terminal_type="subprocess",
+        inherit_environment=False,
+        env={
+            "PATH": "/usr/bin:/bin",
+            "LANG": "C.UTF-8",
+            "RESEARCH_SETTING": "retained",
+        },
+    )
+    try:
+        for reset in [False, True]:
+            if reset:
+                executor.reset()
+            observation = executor(TerminalAction(command="env"))
+            assert observation.metadata.exit_code == 0
+            assert "RESEARCH_SETTING=retained" in observation.text
+            for key in tokens:
+                assert key + "=" not in observation.text
+    finally:
+        executor.close()
+
+
+def test_public_factory_propagates_selection(tmp_path):
+    state = SimpleNamespace(
+        workspace=SimpleNamespace(working_dir=str(tmp_path)),
+        env_observation_persistence_dir=None,
+    )
+    tools = TerminalTool.create(
+        state,
+        terminal_type="subprocess",
+        inherit_environment=False,
+        env={"PATH": "/usr/bin:/bin"},
+    )
+    try:
+        assert tools[0].executor._inherit_environment is False
+    finally:
+        tools[0].executor.close()
+
+
+@pytest.mark.parametrize("backend", ["tmux", "subprocess", "powershell"])
+def test_session_factory_propagates_selection(tmp_path, monkeypatch, backend):
+    monkeypatch.setattr(factory, "_is_tmux_available", lambda: True)
+    monkeypatch.setattr(
+        factory, "_get_powershell_command", lambda *args, **kwargs: "/bin/pwsh"
+    )
+    session = factory.create_terminal_session(
+        str(tmp_path), terminal_type=backend, inherit_environment=False
+    )
+    assert session.terminal._inherit_environment is False
+
+
+def test_windows_process_receives_only_selected_environment(tmp_path, monkeypatch):
+    monkeypatch.setenv("TERMINAL_TEST_SECRET", "synthetic")
+    terminal = WindowsTerminal(
+        str(tmp_path), env={"PATH": "/bin"}, inherit_environment=False
+    )
+
+    class Started(Exception):
+        pass
+
+    def launch(*args, **kwargs):
+        assert "TERMINAL_TEST_SECRET" not in kwargs["env"]
+        assert kwargs["env"]["PATH"] == "/bin"
+        raise Started
+
+    monkeypatch.setattr(
+        "openhands.tools.terminal.terminal.windows_terminal.subprocess.Popen", launch
+    )
+    with pytest.raises(Started):
+        terminal.initialize()
+
+
+def test_first_tmux_process_receives_selected_environment(tmp_path, monkeypatch):
+    monkeypatch.setenv("TERMINAL_TEST_SECRET", "synthetic")
+    monkeypatch.setenv("TMUX_TMPDIR", str(tmp_path))
+    server = MagicMock()
+    monkeypatch.setattr(
+        "openhands.tools.terminal.terminal.tmux_terminal.libtmux.Server",
+        lambda **kwargs: server,
+    )
+    monkeypatch.setattr(
+        "openhands.tools.terminal.terminal.tmux_terminal.shutil.which",
+        lambda name: "/bin/tmux",
+    )
+    launch = MagicMock()
+    monkeypatch.setattr(
+        "openhands.tools.terminal.terminal.tmux_terminal.subprocess.run", launch
+    )
+    env = {"PATH": "/bin", "LANG": "C.UTF-8"}
+    _new_owned_session(
+        env,
+        session_name="test",
+        start_directory=str(tmp_path),
+        x=80,
+        y=24,
+        inherit_environment=False,
+    )
+    assert launch.call_args.kwargs["env"] == env
+    assert launch.call_args.kwargs["timeout"] == 30
+    server.new_session.assert_not_called()
+
+
+def test_pool_recovery_retains_environment_selection(tmp_path, monkeypatch):
+    monkeypatch.setattr(
+        "openhands.tools.terminal.impl._is_tmux_available", lambda: True
+    )
+    pool_type = MagicMock()
+    monkeypatch.setattr("openhands.tools.terminal.impl.TmuxPanePool", pool_type)
+    executor = TerminalExecutor(
+        str(tmp_path), inherit_environment=False, env={"PATH": "/bin"}
+    )
+    first_pool = executor._pool
+    executor._recover_tmux_pool(first_pool)
+    assert pool_type.call_count == 2
+    for call in pool_type.call_args_list:
+        assert call.kwargs["inherit_environment"] is False
+        assert call.kwargs["env"] == {"PATH": "/bin"}
+    executor.close()
+
+
+@pytest.mark.skipif(shutil.which("tmux") is None, reason="tmux executable unavailable")
+@pytest.mark.parametrize("pooled", [False, True])
+def test_tmux_commands_exclude_inherited_environment(tmp_path, monkeypatch, pooled):
+    monkeypatch.setenv("TERMINAL_TEST_SECRET", "synthetic")
+    env = {"PATH": "/usr/bin:/bin", "LANG": "C.UTF-8", "RESEARCH_SETTING": "retained"}
+    if pooled:
+        terminal = TerminalExecutor(
+            str(tmp_path), terminal_type="tmux", inherit_environment=False, env=env
+        )
+        execute = terminal
+    else:
+        terminal = factory.create_terminal_session(
+            str(tmp_path), terminal_type="tmux", inherit_environment=False, env=env
+        )
+        terminal.initialize()
+        execute = terminal.execute
+    try:
+        observation = execute(TerminalAction(command="env"))
+        assert observation.metadata.exit_code == 0
+        assert "TERMINAL_TEST_SECRET=" not in observation.text
+        assert "RESEARCH_SETTING=retained" in observation.text
+    finally:
+        terminal.close()
