+        request_id: uuid::Uuid::new_v4().to_string(),
+    };
+
+    // The caller goes away while the owner executes; the owner still records.
+    let worker_state = state.clone();
+    let request = controlled_failure(&req, &control, "dev-user");
+    let caller = tokio::spawn(async move { run(&worker_state, request).await });
+    tokio::time::timeout(Duration::from_secs(5), control.started.notified())
+        .await
+        .unwrap();
+    caller.abort();
+    assert_eq!(
+        reason(
+            &run(&state, controlled_failure(&req, &control, "dev-user"))
+                .await
+                .unwrap_err()
+        ),
+        "REQUEST_OUTCOME_UNCERTAIN"
+    );
+    control.proceed.notify_one();
+    let replayed = tokio::time::timeout(Duration::from_secs(5), async {
+        loop {
+            let status = run(&state, controlled_failure(&req, &control, "dev-user"))
+                .await
+                .unwrap_err();
+            if reason(&status) == "REQUEST_FAILED" {
+                break status;
+            }
+            assert_eq!(reason(&status), "REQUEST_OUTCOME_UNCERTAIN");
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .unwrap();
+    assert_recorded_failure(&replayed, Code::FailedPrecondition, Some("TEST_REFUSAL"));
+    assert_eq!(control.calls.load(Ordering::SeqCst), 1);
+
+    let rows = state
+        .store
+        .list_by_type_after(OBJECT_TYPE, None, 10)
+        .await
+        .unwrap();
+    assert_eq!(rows.len(), 1);
+    let row = rows.into_iter().next().unwrap();
+    assert!(row.resource_version > 1);
+    assert!(!String::from_utf8_lossy(&row.payload).contains("private detail"));
+    let admission: Admission = serde_json::from_slice(&row.payload).unwrap();
+    assert!(admission.success.is_none());
+    assert!(admission.terminal());
+
+    // Another caller with the same request_id has its own admission and
+    // cannot read, complete, or remove this one.
+    control.proceed.notify_one();
+    let other = run(&state, controlled_failure(&req, &control, "other-user"))
+        .await
+        .unwrap_err();
+    assert_eq!(reason(&other), "TEST_REFUSAL");
+    assert_eq!(control.calls.load(Ordering::SeqCst), 2);
+    assert_eq!(
+        state
+            .store
+            .get(OBJECT_TYPE, &row.id)
+            .await
+            .unwrap()
+            .unwrap()
+            .payload,
+        row.payload
+    );
+
+    // The record is kept for the replay window and then swept like a success.
+    let window_ms = replay_window_ms(&state.config);
+    assert!(
+        !sweep_expired(&state.store, Some(&row.workspace), window_ms)
+            .await
+            .unwrap()
+    );
+    let mut aged = admission;
+    aged.completed_at_ms = Some(current_time_ms() - window_ms - 1);
+    state
+        .store
+        .put_if(
+            OBJECT_TYPE,
+            &row.id,
+            &row.name,
+            &row.workspace,
+            &serde_json::to_vec(&aged).unwrap(),
+            None,
+            WriteCondition::MatchResourceVersion(row.resource_version),
+        )
+        .await
+        .unwrap();
+    state
+        .store
+        .backdate(&row.id, current_time_ms() - window_ms - 1)
+        .await
+        .unwrap();
+    assert!(
+        sweep_expired(&state.store, Some(&row.workspace), window_ms)
+            .await
+            .unwrap()
+    );
+    assert_eq!(
+        state
+            .store
+            .count_in_workspace(OBJECT_TYPE, &row.workspace)
+            .await
+            .unwrap(),
+        0
+    );
+    control.proceed.notify_one();
+    assert_eq!(
+        reason(
+            &run(&state, controlled_failure(&req, &control, "dev-user"))
+                .await
+                .unwrap_err()
+        ),
+        "TEST_REFUSAL"
+    );
+    assert_eq!(control.calls.load(Ordering::SeqCst), 3);
+}
+
+#[test]
+fn success_records_keep_their_encoding_without_a_failure() {
+    // The row as a gateway without recorded failures decodes it.
+    #[derive(Deserialize)]
+    struct Previous {
+        format_version: u32,
+        success: Option<Success>,
+        completed_at_ms: Option<i64>,
+    }
+    let admission = Admission {
+        format_version: 1,
+        payload_hash: "unused".into(),
+        protection: None,
+        workspace_id: None,
+        target_id: None,
+        success: Some(Success::StreamTerminal),
+        failure: None,
+        completed_at_ms: Some(1),
+    };
+    let encoded = String::from_utf8(serde_json::to_vec(&admission).unwrap()).unwrap();
+    assert!(!encoded.contains("failure"));
+    // A row written before failures were recorded still decodes.
+    let legacy: Admission = serde_json::from_str(&encoded).unwrap();
+    assert!(legacy.failure.is_none() && legacy.terminal());
+    // A gateway without recorded failures reads one as unresolved: no success.
+    let recorded = Admission {
+        success: None,
+        failure: Some(Failure {
+            code: Code::NotFound as i32,
+            reason: None,
+        }),
+        ..admission
+    };
+    let previous: Previous =
+        serde_json::from_slice(&serde_json::to_vec(&recorded).unwrap()).unwrap();
+    assert_eq!(previous.format_version, 1);
+    assert!(previous.success.is_none() && previous.completed_at_ms.is_some());
+    let failed = Failure::new(&Status::with_error_details(
+        Code::FailedPrecondition,
+        "detail",
+        ErrorDetails::with_error_info("lower-case reason", rpc_error::ERROR_DOMAIN, HashMap::new()),
+    ));
+    assert!(failed.reason.is_none());
+    let foreign = Failure::new(&Status::with_error_details(
+        Code::Internal,
+        "detail",
+        ErrorDetails::with_error_info("FOREIGN", "example.com", HashMap::new()),
+    ));
+    assert!(foreign.reason.is_none());
+    assert_eq!(foreign.code, Code::Internal as i32);
+}
