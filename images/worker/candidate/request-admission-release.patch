+/// Make every completed admission older than the replay window.
+async fn expire_terminal_admissions(state: &Arc<ServerState>) {
+    let past = crate::persistence::current_time_ms()
+        - crate::grpc::mutation_replay::replay_window_ms(&state.config)
+        - 1;
+    for row in state
+        .store
+        .list_by_type_after(OBJECT_TYPE, None, 100)
+        .await
+        .unwrap()
+    {
+        let mut admission: Admission = serde_json::from_slice(&row.payload).unwrap();
+        assert!(admission.terminal());
+        admission.completed_at_ms = Some(past);
+        state
+            .store
+            .put_if(
+                OBJECT_TYPE,
+                &row.id,
+                &row.name,
+                &row.workspace,
+                &serde_json::to_vec(&admission).unwrap(),
+                None,
+                crate::persistence::WriteCondition::MatchResourceVersion(row.resource_version),
+            )
+            .await
+            .unwrap();
+        state.store.backdate(&row.id, past).await.unwrap();
+    }
+}
