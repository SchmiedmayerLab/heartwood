+    let (_directory, mut state) = protected_state().await;
+    {
+        let state = Arc::get_mut(&mut state).unwrap();
+        state.config.mutation_admission_limit_per_caller = 2;
+        state.admin_role = "openshell-admin".into();
+    }
+    let mut creation = create_sandbox("failed-creation");
+    creation.spec = None;
+    let deletion = DeleteSandboxRequest {
+        name: "never-created".into(),
+        workspace_scope: Some(openshell_core::proto::workspace_selector("default")),
+        allow_missing: false,
+        request_id: id(),
+    };
+    assert_eq!(
+        run(&state, authed_request(creation.clone()))
+            .await
+            .unwrap_err()
+            .code(),
+        Code::InvalidArgument
+    );
+    assert_eq!(
+        run(&state, authed_request(deletion.clone()))
+            .await
+            .unwrap_err()
+            .code(),
+        Code::NotFound
+    );
+    // Replays are refused without executing again, and the slots stay taken
+    // for the replay window.
+    assert_replayed_failure(
+        &run(&state, authed_request(creation.clone()))
+            .await
+            .unwrap_err(),
+        Code::InvalidArgument,
+    );
+    assert_replayed_failure(
+        &run(&state, authed_request(deletion.clone()))
+            .await
+            .unwrap_err(),
+        Code::NotFound,
+    );
+    // The replay checks still come first: a changed payload is a mismatch, and
+    // a caller who lost access gets the current denial.
+    let mut changed = deletion.clone();
+    changed.allow_missing = true;
+    assert_eq!(
+        reason(&run(&state, authed_request(changed)).await.unwrap_err()),
+        "REQUEST_ID_PAYLOAD_MISMATCH"
+    );
+    let mut revoked = authed_request(deletion.clone());
+    if let Principal::User(user) = revoked.extensions_mut().get_mut::<Principal>().unwrap() {
+        user.identity.roles.clear();
+    }
+    let denied = run(&state, revoked).await.unwrap_err();
+    assert_eq!(denied.code(), Code::NotFound);
+    assert_eq!(denied.message(), "sandbox not found");
+    let next = create_sandbox("after-failures");
+    assert_eq!(
+        run(&state, authed_request(next.clone()))
+            .await
+            .unwrap_err()
+            .code(),
+        Code::ResourceExhausted
+    );
+    assert!(
+        state
+            .store
+            .get_message_by_name::<Sandbox>("default", "after-failures")
+            .await
+            .unwrap()
+            .is_none()
