+            .unwrap_err()
+            .code(),
+        Code::NotFound
+    );
+    run(&state, authed_request(next)).await.unwrap();
+    assert_eq!(
+        state
+            .store
+            .list_by_type_after(OBJECT_TYPE, None, 100)
+            .await
+            .unwrap()
+            .len(),
