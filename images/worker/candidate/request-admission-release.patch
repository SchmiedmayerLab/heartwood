+#[derive(Clone, PartialEq, Message)]
+struct ControlledFailure {
+    #[prost(string, tag = "1")]
+    name: String,
+    #[prost(string, tag = "3")]
+    request_id: String,
+}
+
+impl Mutation for ControlledFailure {
+    type Output = CreateWorkspaceResponse;
+    const METHOD: &'static str = "CreateWorkspace";
+    const REPLAY_METHOD: &'static str = "/test/ControlledFailure";
+    const RECORD_FAILURES: bool = true;
+    fn request_id(&self) -> &str {
+        &self.request_id
+    }
+    async fn authorize(&self, state: &ServerState, principal: &Principal) -> Result<Scope, Status> {
+        CreateWorkspaceRequest {
+            name: self.name.clone(),
+            ..Default::default()
+        }
+        .authorize(state, principal)
+        .await
+    }
+    async fn execute(
+        _state: &Arc<ServerState>,
+        request: Request<Self>,
+    ) -> Result<Response<Self::Output>, Status> {
+        let control = request.extensions().get::<Arc<Control>>().unwrap().clone();
+        control.calls.fetch_add(1, Ordering::SeqCst);
+        control.started.notify_one();
+        control.proceed.notified().await;
+        Err(rpc_error::failed_precondition(
+            "TEST_REFUSAL",
+            "message with private detail",
+        ))
+    }
+    fn capture(response: &Response<Self::Output>) -> Result<Success, Status> {
+        resource_success(response.get_ref().workspace.as_ref())
+    }
+    async fn restore(store: &Store, success: Success) -> Result<Self::Output, Status> {
+        Ok(CreateWorkspaceResponse {
+            workspace: Some(restore_resource(store, success).await?),
+        })
+    }
+}
+
+fn controlled_failure(
+    req: &ControlledFailure,
+    control: &Arc<Control>,
+    subject: &str,
+) -> Request<ControlledFailure> {
+    let mut request = authed_request(req.clone());
+    request.extensions_mut().insert(control.clone());
+    if let Principal::User(user) = request.extensions_mut().get_mut::<Principal>().unwrap() {
+        user.identity.subject = subject.into();
+    }
+    request
+}
+
+fn assert_recorded_failure(status: &Status, code: Code, original_reason: Option<&str>) {
+    assert_eq!(status.code(), Code::FailedPrecondition);
+    assert_eq!(status.metadata().get("openshell-replayed").unwrap(), "true");
+    assert!(!status.message().contains("private detail"));
+    let details = status.get_error_details();
+    let info = details.error_info().unwrap();
+    assert_eq!(info.reason, "REQUEST_FAILED");
+    assert_eq!(
+        info.metadata.get("original_code").unwrap(),
+        &(code as i32).to_string()
+    );
+    assert_eq!(
+        info.metadata.get("original_reason").map(String::as_str),
+        original_reason
+    );
+    assert!(details.retry_info().is_none());
+}
