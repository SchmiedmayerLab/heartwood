+/// A handler error of an adapter that records failures. Only the status code
+/// and the gateway's own error reason are kept, never the message.
+#[derive(Serialize, Deserialize)]
+struct Failure {
+    code: i32,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    reason: Option<String>,
+}
+
+impl Failure {
+    fn new(status: &Status) -> Self {
+        let reason = status
+            .get_error_details()
+            .error_info()
+            .filter(|info| {
+                info.domain == rpc_error::ERROR_DOMAIN
+                    && (1..=64).contains(&info.reason.len())
+                    && info
+                        .reason
+                        .bytes()
+                        .all(|b| b.is_ascii_uppercase() || b.is_ascii_digit() || b == b'_')
+            })
+            .map(|info| info.reason.clone());
+        Self {
+            code: status.code() as i32,
+            reason,
+        }
+    }
+
+    /// The same refusal for every replay. It is not retryable, and it never
+    /// claims that the failed attempt had no effects.
+    fn replay(self) -> Status {
+        let mut metadata = HashMap::from([("original_code".to_string(), self.code.to_string())]);
+        if let Some(reason) = self.reason {
+            metadata.insert("original_reason".into(), reason);
+        }
+        let mut status = Status::with_error_details(
+            Code::FailedPrecondition,
+            "the original request failed and was not executed again; reconcile its effects before starting a new request with a new request_id",
+            ErrorDetails::with_error_info("REQUEST_FAILED", rpc_error::ERROR_DOMAIN, metadata),
+        );
+        status.metadata_mut().insert(
+            "openshell-replayed",
+            "true".parse().expect("static metadata"),
+        );
+        status
+    }
+}
