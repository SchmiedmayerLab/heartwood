+#[tokio::test]
+async fn failed_sandbox_start_stop_and_update_record_their_failures() {
+    let (_directory, mut state) = protected_state().await;
+    {
+        let state = Arc::get_mut(&mut state).unwrap();
+        state.config.mutation_admission_limit_per_caller = 3;
+        state.admin_role = "openshell-admin".into();
+    }
+    let mut existing = create_sandbox("lifecycle");
+    existing.request_id = String::new();
+    let sandbox = run(&state, authed_request(existing))
+        .await
+        .unwrap()
+        .into_inner()
+        .sandbox
+        .unwrap();
+    let sandbox = state
+        .store
+        .update_message_cas::<Sandbox, _>(
+            sandbox.object_id(),
+            sandbox.get_resource_version(),
+            |sandbox| sandbox.set_phase(SandboxPhase::Stopped as i32),
+        )
+        .await
+        .unwrap();
+    let scope = || Some(openshell_core::proto::workspace_selector("default"));
+    let start = StartSandboxRequest {
+        name: "missing".into(),
+        workspace_scope: scope(),
+        request_id: id(),
+    };
+    let stop = StopSandboxRequest {
+        name: "missing".into(),
+        workspace_scope: scope(),
+        request_id: id(),
+    };
+    // A stale resource version fails before any driver call.
+    let update = openshell_core::proto::UpdateSandboxRequest {
+        name: "lifecycle".into(),
+        workspace_scope: scope(),
+        labels: Some(openshell_core::proto::SandboxMapUpdate {
+            values: HashMap::from([("team".into(), "agents".into())]),
+        }),
+        expected_resource_version: sandbox.get_resource_version() + 1,
+        request_id: id(),
+        ..Default::default()
+    };
+    let failed = run(&state, authed_request(update.clone()))
+        .await
+        .unwrap_err();
+    assert_eq!(failed.code(), Code::Aborted);
+    let update_reason = failed
+        .get_error_details()
+        .error_info()
+        .map(|info| info.reason.clone());
+    assert_eq!(
+        run(&state, authed_request(start.clone()))
+            .await
+            .unwrap_err()
+            .code(),
+        Code::NotFound
+    );
+    assert_eq!(
+        run(&state, authed_request(stop.clone()))
+            .await
+            .unwrap_err()
+            .code(),
+        Code::NotFound
+    );
+
+    // Each replay is refused with the original code and is not executed again:
+    // a sandbox created under the missing name afterwards is not started or
+    // stopped, and the update is not applied once its version matches.
+    let mut late = create_sandbox("missing");
+    late.request_id = String::new();
+    let late = run(&state, authed_request(late))
+        .await
+        .unwrap()
+        .into_inner()
+        .sandbox
+        .unwrap();
+    let bumped = state
+        .store
+        .update_message_cas::<Sandbox, _>(
+            sandbox.object_id(),
+            sandbox.get_resource_version(),
+            |_| {},
+        )
+        .await
+        .unwrap();
+    assert_eq!(
+        bumped.get_resource_version(),
+        update.expected_resource_version
+    );
+    let mut versions = Vec::new();
+    for id in [late.object_id(), sandbox.object_id()] {
+        let stored = state
+            .store
+            .get_message::<Sandbox>(id)
+            .await
+            .unwrap()
+            .unwrap();
+        versions.push((id.to_string(), stored.get_resource_version()));
+    }
+    assert_replayed_failure(
+        &run(&state, authed_request(start.clone()))
+            .await
+            .unwrap_err(),
+        Code::NotFound,
+    );
+    assert_replayed_failure(
+        &run(&state, authed_request(stop.clone())).await.unwrap_err(),
+        Code::NotFound,
+    );
+    let replayed = run(&state, authed_request(update.clone()))
+        .await
+        .unwrap_err();
+    assert_replayed_failure(&replayed, Code::Aborted);
+    assert_eq!(
+        replayed
+            .get_error_details()
+            .error_info()
+            .unwrap()
+            .metadata
+            .get("original_reason")
+            .cloned(),
+        update_reason
+    );
+    for (id, version) in versions {
+        let stored = state
+            .store
+            .get_message::<Sandbox>(&id)
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(stored.get_resource_version(), version);
+        assert!(!stored.metadata.unwrap().labels.contains_key("team"));
+    }
+
+    // The replay checks still come first.
+    let mut changed = update.clone();
+    changed.labels = None;
+    changed.annotations = Some(openshell_core::proto::SandboxMapUpdate {
+        values: HashMap::from([("example.com/revision".into(), "2".into())]),
+    });
+    assert_eq!(
+        reason(&run(&state, authed_request(changed)).await.unwrap_err()),
+        "REQUEST_ID_PAYLOAD_MISMATCH"
+    );
+    let mut revoked = authed_request(stop.clone());
+    if let Principal::User(user) = revoked.extensions_mut().get_mut::<Principal>().unwrap() {
+        user.identity.roles.clear();
+    }
+    let denied = run(&state, revoked).await.unwrap_err();
+    assert_eq!(denied.code(), Code::NotFound);
+    assert_eq!(denied.message(), "sandbox not found");
+
+    // Only the code and the gateway reason are stored.
+    let rows = state
+        .store
+        .list_by_type_after(OBJECT_TYPE, None, 100)
+        .await
+        .unwrap();
+    assert_eq!(rows.len(), 3);
+    for row in &rows {
+        let admission: Admission = serde_json::from_slice(&row.payload).unwrap();
+        assert!(admission.failure.is_some() && admission.success.is_none());
+        let payload = String::from_utf8(row.payload.clone()).unwrap();
+        assert!(!payload.contains(failed.message()), "{payload}");
+        assert!(!payload.contains("not found"), "{payload}");
+    }
+
+    let next = create_sandbox("after-lifecycle");
+    assert_eq!(
+        run(&state, authed_request(next.clone()))
+            .await
+            .unwrap_err()
+            .code(),
+        Code::ResourceExhausted
+    );
+
+    // After the window, the same request ID executes again, as after a success.
+    state
+        .store
+        .delete(Sandbox::object_type(), late.object_id())
+        .await
+        .unwrap();
+    expire_terminal_admissions(&state).await;
+    let again = run(&state, authed_request(start)).await.unwrap_err();
+    assert_eq!(again.code(), Code::NotFound, "{again:?}");
+    assert!(again.metadata().get("openshell-replayed").is_none());
+    run(&state, authed_request(next)).await.unwrap();
+    run(&state, authed_request(create_sandbox("third-slot")))
+        .await
+        .unwrap();
+    assert_eq!(
+        run(&state, authed_request(create_sandbox("fourth-slot")))
+            .await
+            .unwrap_err()
+            .code(),
+        Code::ResourceExhausted
+    );
+}
