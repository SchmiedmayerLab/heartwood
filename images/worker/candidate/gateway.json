  "patches": [
    {
      "path": "docker-provisioning.patch",
      "sha256": "f36989e0cddf843d79ee8d43376704c4358decc906ad3c92bf40db6c429534c1",
      "purpose": "Retain ownership of a Docker sandbox while provisioning is in progress so deletion can be retried after provisioning settles."
    },
    {
      "path": "gateway-delete-retry.patch",
      "sha256": "a9319c79ffbb8d4ad93575bdc0d54df1a070d0083e18a29ba31a378c6532ed3b",
      "purpose": "Call the driver again when a sandbox already marked for deletion receives another delete request."
    },
    {
      "path": "kubernetes-delete-conflict.patch",
      "sha256": "5cf974a3e13b892367adf3ab531780852f7a200b08bd947801de980ae7561e37",
      "purpose": "Report a conflicting Kubernetes sandbox deletion as an error so the caller retries instead of treating the sandbox as absent."
    },
    {
      "path": "gateway-create-after-absence.patch",
      "sha256": "70bf2811f124c5cedb29a7b1add4ed69f513995ffbe455d09167d2c7f5ffde7d",
      "purpose": "Record confirmed absence so a delayed create request cannot recreate a sandbox under its revoked name during the retention window."
    },
    {
      "path": "request-admission-release.patch",
      "sha256": "a2938af2d3f8b19ff85acd1c141eb7d709d15df0ac653a20656ef02e14e649a0",
      "purpose": "Record a failed sandbox creation or deletion with a request identifier as a terminal admission, so a repeated delivery is refused without executing and its admission slot is released after the replay window."
    },
    {
      "path": "request-admission-lifecycle.patch",
      "sha256": "96aad5e517f7337631ab815c7316cc7313d75106e2a3a3cc904206e17200b1f6",
      "purpose": "Record failed sandbox start, stop and update requests with a request identifier the same way, so their admission slots are also released after the replay window."
    }
  ],
