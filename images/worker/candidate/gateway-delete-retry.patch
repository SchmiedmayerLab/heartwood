+    #[tokio::test]
+    async fn explicit_delete_retry_fences_another_replicas_error_recovery() {
+        let driver = ControlledDriver::new();
+        driver.block_delete();
+        driver.block_get();
+        driver.set_delete_outcome(ControlledDeleteOutcome::Error("delete failed"));
+        driver.set_get_outcome(ControlledGetOutcome::Error("lookup failed"));
+        let runtime = test_runtime(driver.clone()).await;
+        let mut other = runtime.clone();
+        other.mutation_locks = Arc::new(LocalMutationLocks::new());
+        other.lifecycle_gates = Arc::new(LifecycleGateRegistry::default());
+        let mut sandbox = sandbox_record("sb-1", "sandbox-a", SandboxPhase::Ready);
+        sandbox.set_current_policy_version(9);
+        runtime.store.put_message(&sandbox).await.unwrap();
+
+        let first_runtime = runtime.clone();
+        let first =
+            tokio::spawn(async move { first_runtime.delete_sandbox("default", "sandbox-a").await });
+        tokio::time::timeout(Duration::from_secs(1), driver.delete_started.notified())
+            .await
+            .expect("first delete did not reach the driver");
+        driver.release_delete();
+        tokio::time::timeout(Duration::from_secs(1), driver.get_started.notified())
+            .await
+            .expect("first delete did not reach recovery");
+        let original_fence = runtime
+            .store
+            .get_message::<Sandbox>("sb-1")
+            .await
+            .unwrap()
+            .unwrap();
+
+        let second =
+            tokio::spawn(async move { other.delete_sandbox("default", "sandbox-a").await });
+        tokio::time::timeout(Duration::from_secs(1), driver.delete_started.notified())
+            .await
+            .expect("retry did not reach the driver");
+        let refreshed = runtime
+            .store
+            .get_message::<Sandbox>("sb-1")
+            .await
+            .unwrap()
+            .unwrap();
+        assert!(sandbox_resource_version(&refreshed) > sandbox_resource_version(&original_fence));
+
+        driver.release_get();
+        tokio::time::timeout(Duration::from_secs(1), first)
+            .await
+            .unwrap()
+            .unwrap()
+            .unwrap_err();
+        let retained = runtime
+            .store
+            .get_message::<Sandbox>("sb-1")
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(retained.phase(), SandboxPhase::Deleting as i32);
+        assert_eq!(retained.current_policy_version(), 9);
+        assert_eq!(
+            sandbox_resource_version(&retained),
+            sandbox_resource_version(&refreshed)
+        );
+
+        driver.release_delete();
+        tokio::time::timeout(Duration::from_secs(1), second)
+            .await
+            .unwrap()
+            .unwrap()
+            .unwrap_err();
+        assert_eq!(driver.delete_calls(), 2);
+        assert_eq!(
+            runtime
+                .store
+                .get_message::<Sandbox>("sb-1")
+                .await
+                .unwrap()
+                .unwrap(),
+            retained
+        );
+    }
