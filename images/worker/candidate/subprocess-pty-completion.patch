diff --git a/tests/tools/terminal/test_terminal_session.py b/tests/tools/terminal/test_terminal_session.py
index 780f375b..29356649 100644
--- a/tests/tools/terminal/test_terminal_session.py
+++ b/tests/tools/terminal/test_terminal_session.py
@@ -43,6 +43,70 @@ terminal_types = ["tmux", "subprocess"]
 parametrize_terminal_types = pytest.mark.parametrize("terminal_type", terminal_types)
 
 
+@pytest.mark.skipif(os.name == "nt", reason="requires a Unix PTY")
+def test_subprocess_clear_keeps_prompt_without_submitting_input(tmp_path, monkeypatch):
+    from openhands.tools.terminal.metadata import CmdOutputMetadata
+    from openhands.tools.terminal.terminal.subprocess_terminal import SubprocessTerminal
+
+    terminal = SubprocessTerminal(str(tmp_path))
+    terminal.initialize()
+    try:
+        writes = []
+        monkeypatch.setattr(terminal, "_write_pty", writes.append)
+        prompt = terminal.read_screen()
+        assert len(CmdOutputMetadata.matches_ps1_metadata(prompt)) == 1
+        with terminal.output_lock:
+            terminal.output_buffer.clear()
+            terminal._add_text_to_buffer(
+                ("discard me\n" + prompt).replace("\n", "\r\n")
+            )
+        terminal.clear_screen()
+        screen = terminal.read_screen()
+        assert "discard me" not in screen
+        assert len(CmdOutputMetadata.matches_ps1_metadata(screen)) == 1
+        with terminal.output_lock:
+            terminal.output_buffer.clear()
+        terminal.clear_screen()
+        assert writes == []
+    finally:
+        monkeypatch.undo()
+        terminal.close()
+
+
+@pytest.mark.skipif(os.name == "nt", reason="requires a Unix PTY")
+def test_subprocess_waits_for_child_exit(tmp_path):
+    from concurrent.futures import ThreadPoolExecutor
+
+    session = create_terminal_session(
+        work_dir=str(tmp_path), terminal_type="subprocess"
+    )
+    session.initialize()
+    release = tmp_path / "release"
+    try:
+        with ThreadPoolExecutor(max_workers=1) as executor:
+            result = executor.submit(
+                session.execute,
+                TerminalAction(
+                    command="sh -c 'echo $$ > child; "
+                    "while [ ! -e release ]; do sleep 0.02; done; exit 7'"
+                ),
+            )
+            try:
+                child = tmp_path / "child"
+                deadline = time.monotonic() + 5
+                while not (child.exists() and child.stat().st_size):
+                    assert time.monotonic() < deadline
+                    time.sleep(0.01)
+                os.kill(int(child.read_text()), 0)
+                with pytest.raises(TimeoutError):
+                    result.result(timeout=0.25)
+            finally:
+                release.touch()
+            assert result.result(timeout=5).exit_code == 7
+    finally:
+        session.close()
+
+
 @parametrize_terminal_types
