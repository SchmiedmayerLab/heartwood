{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Values of the Heartwood reference platform chart",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "images",
    "projects",
    "postgresql",
    "keycloak",
    "versitygw",
    "sessions",
    "control",
    "researchers",
    "syntheticPrices"
  ],
  "$defs": {
    "image": {
      "description": "An image reference pinned by digest.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/:-]*@sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$"
    },
    "reference": {
      "type": "string",
      "pattern": "^\\S{1,512}$"
    },
    "decimal": {
      "description": "A nonnegative decimal number written as a string, with at most 18 integer and 12 fractional digits.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,12})?$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    }
  },
  "properties": {
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "postgresql",
        "keycloak",
        "versitygw",
        "platformServices",
        "openshellGateway",
        "openshellRepository"
      ],
      "properties": {
        "postgresql": {
          "$ref": "#/$defs/image"
        },
        "keycloak": {
          "$ref": "#/$defs/image"
        },
        "versitygw": {
          "$ref": "#/$defs/image"
        },
        "platformServices": {
          "$ref": "#/$defs/image"
        },
        "openshellGateway": {
          "$ref": "#/$defs/image"
        },
        "openshellRepository": {
          "description": "A registry repository without tag or digest, or empty.",
          "type": "string",
          "pattern": "^([a-z0-9][a-z0-9.-]*(:[0-9]+)?(/[a-z0-9][a-z0-9._-]*)*)?$"
        }
      }
    },
    "storageClassName": {
      "type": "string"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "billingAttributionRef",
          "policyRef"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "billingAttributionRef": {
            "$ref": "#/$defs/reference"
          },
          "policyRef": {
            "$ref": "#/$defs/reference"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,64}$"
            }
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage"
      ],
      "properties": {
        "storage": {
          "type": "string"
        }
      }
    },
    "keycloak": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https://[^/]+)?$"
        }
      }
    },
    "versitygw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage"
      ],
      "properties": {
        "storage": {
          "type": "string"
        }
      }
    },
    "sessions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "stagingImages",
        "attemptStorageClass",
        "apiServer",
        "quota",
        "containerDefaults",
        "containerDefaultRequests"
      ],
      "properties": {
        "namespace": {
          "allOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "not": {
                "pattern": "^(heartwood-platform$|hw-s-)"
              }
            }
          ]
        },
        "stagingImages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/image"
          }
        },
        "attemptStorageClass": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provisioner"
          ],
          "properties": {
            "provisioner": {
              "type": "string"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "apiServer": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cidr",
              "port"
            ],
            "properties": {
              "cidr": {
                "type": "string",
                "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        },
        "quota": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "containerDefaults": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "containerDefaultRequests": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platformId",
        "storage",
        "serviceCallers",
        "redirectUriTemplate"
      ],
      "properties": {
        "platformId": {
          "$ref": "#/$defs/reference"
        },
        "storage": {
          "type": "string"
        },
        "serviceCallers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^system:serviceaccount:[a-z0-9-]+:[a-z0-9-]+$"
          }
        },
        "redirectUriTemplate": {
          "type": "string",
          "pattern": "^https?://[^{}\\s]+/[^\\s]*\\{subject\\}[^\\s]*\\{project\\}[^\\s]*$"
        }
      }
    },
    "syntheticPrices": {
      "description": "The price sheet of the control service's estimates.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimateValiditySeconds",
        "skuPrices",
        "runtimeProfiles"
      ],
      "properties": {
        "estimateValiditySeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "skuPrices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ServiceProviderName",
              "SkuId",
              "SkuPriceId",
              "ChargeCategory",
              "UnitPrice",
              "UnitPriceType",
              "PricingUnit",
              "PricingCurrency",
              "PricingCurrencyCategory",
              "SkuPriceEffectiveStart",
              "SkuPriceEligibility"
            ],
            "properties": {
              "ServiceProviderName": {
                "type": "string",
                "pattern": "\\S",
                "maxLength": 512
              },
              "SkuId": {
                "$ref": "#/$defs/reference"
              },
              "SkuPriceId": {
                "$ref": "#/$defs/reference"
              },
              "ContractId": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/reference"
                  }
                ]
              },
              "ChargeCategory": {
                "const": "Usage"
              },
              "UnitPrice": {
                "$ref": "#/$defs/decimal"
              },
              "UnitPriceType": {
                "enum": [
                  "List",
                  "Base",
                  "Contracted"
                ]
              },
              "PricingUnit": {
                "type": "string",
                "pattern": "\\S",
                "maxLength": 512
              },
              "PricingCurrency": {
                "$ref": "#/$defs/reference"
              },
              "PricingCurrencyCategory": {
                "enum": [
                  "Payable",
                  "Consumable"
                ]
              },
              "SkuPriceEffectiveStart": {
                "$ref": "#/$defs/timestamp"
              },
              "SkuPriceEffectiveEnd": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/timestamp"
                  }
                ]
              },
              "SkuPriceEligibility": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "IsGlobalScope"
                ],
                "properties": {
                  "IsGlobalScope": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        "runtimeProfiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "runtimeProfileRef",
              "kind",
              "rates"
            ],
            "properties": {
              "runtimeProfileRef": {
                "$ref": "#/$defs/reference"
              },
              "kind": {
                "enum": [
                  "exploration",
                  "batch",
                  "inference"
                ]
              },
              "rates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "measure",
                    "skuPriceId",
                    "quantityPerPricingUnit"
                  ],
                  "properties": {
                    "measure": {
                      "enum": [
                        "duration",
                        "task_duration",
                        "input_tokens",
                        "output_tokens"
                      ]
                    },
                    "skuPriceId": {
                      "$ref": "#/$defs/reference"
                    },
                    "quantityPerPricingUnit": {
                      "$ref": "#/$defs/decimal"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "researchers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "username"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "username": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          }
        }
      }
    }
  }
}
