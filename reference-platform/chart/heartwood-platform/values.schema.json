{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Values of the Heartwood reference platform chart",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "images",
    "projects",
    "postgresql",
    "keycloak",
    "versitygw",
    "sessions",
    "control",
    "researchers",
    "syntheticPrices",
    "hub",
    "inference"
  ],
  "$defs": {
    "image": {
      "description": "An image reference pinned by digest.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/:-]*@sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$"
    },
    "reference": {
      "type": "string",
      "pattern": "^\\S{1,512}$"
    },
    "decimal": {
      "description": "A nonnegative decimal number written as a string, with at most 18 integer and 12 fractional digits.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,12})?$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    }
  },
  "properties": {
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "postgresql",
        "keycloak",
        "versitygw",
        "platformServices",
        "openshellGateway",
        "openshellRepository",
        "hostedGateway",
        "litellm",
        "modelRuntime",
        "funnel"
      ],
      "properties": {
        "postgresql": {
          "$ref": "#/$defs/image"
        },
        "keycloak": {
          "$ref": "#/$defs/image"
        },
        "versitygw": {
          "$ref": "#/$defs/image"
        },
        "platformServices": {
          "$ref": "#/$defs/image"
        },
        "openshellGateway": {
          "$ref": "#/$defs/image"
        },
        "openshellRepository": {
          "description": "A registry repository without tag or digest, or empty.",
          "type": "string",
          "pattern": "^([a-z0-9][a-z0-9.-]*(:[0-9]+)?(/[a-z0-9][a-z0-9._-]*)*)?$"
        },
        "hostedGateway": {
          "$ref": "#/$defs/image"
        },
        "litellm": {
          "$ref": "#/$defs/image"
        },
        "modelRuntime": {
          "description": "The runtime image by digest; empty without a local model.",
          "anyOf": [
            {
              "const": ""
            },
            {
              "$ref": "#/$defs/image"
            }
          ]
        },
        "funnel": {
          "$ref": "#/$defs/image"
        }
      }
    },
    "storageClassName": {
      "type": "string"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "billingAttributionRef",
          "policyRef"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "billingAttributionRef": {
            "$ref": "#/$defs/reference"
          },
          "policyRef": {
            "$ref": "#/$defs/reference"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\s\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]([^\\p{Cc}\\p{Cf}\\p{Cs}]*[^\\s\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}])?$"
            }
          },
          "budgets": {
            "description": "Amounts allocated to each category of the project's work, in the currency of the price sheet.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "inference": {
                "$ref": "#/$defs/decimal"
              },
              "compute": {
                "$ref": "#/$defs/decimal"
              }
            }
          },
          "interactiveDataset": {
            "description": "Sealed dataset version mounted at /data for members of this project.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "size",
              "objects",
              "reader"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 1
              },
              "objects": {
                "type": "integer",
                "minimum": 1
              },
              "reader": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9-]{1,128}$"
              }
            }
          },
          "datasets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "description",
                "created",
                "files"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "created": {
                  "type": "string",
                  "format": "date-time"
                },
                "files": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(\\.[A-Za-z0-9_-]+)*$",
                    "maxLength": 128
                  }
                }
              }
            }
          },
          "gpu": {
            "type": "boolean"
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage"
      ],
      "properties": {
        "storage": {
          "type": "string"
        }
      }
    },
    "keycloak": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https://[^/]+)?$"
        }
      }
    },
    "versitygw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage"
      ],
      "properties": {
        "storage": {
          "type": "string"
        }
      }
    },
    "sessions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "stagingImages",
        "attemptStorageClass",
        "apiServer",
        "quota",
        "containerDefaults",
        "containerDefaultRequests"
      ],
      "properties": {
        "namespace": {
          "allOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "not": {
                "pattern": "^(heartwood-platform$|hw-s-)"
              }
            }
          ]
        },
        "stagingImages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/image"
          }
        },
        "attemptStorageClass": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provisioner"
          ],
          "properties": {
            "provisioner": {
              "type": "string"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "apiServer": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cidr",
              "port"
            ],
            "properties": {
              "cidr": {
                "type": "string",
                "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        },
        "quota": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "containerDefaults": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "containerDefaultRequests": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platformId",
        "storage",
        "serviceCallers",
        "operatorCallers",
        "inference",
        "contextCallers"
      ],
      "properties": {
        "platformId": {
          "$ref": "#/$defs/reference"
        },
        "storage": {
          "type": "string"
        },
        "serviceCallers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^system:serviceaccount:[a-z0-9-]+:[a-z0-9-]+$"
          }
        },
        "operatorCallers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^system:serviceaccount:[a-z0-9-]+:[a-z0-9-]+$"
          }
        },
        "inference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionReservation"
          ],
          "properties": {
            "sessionReservation": {
              "description": "Amount of its project's inference budget that each session reserves at its first launch, or what is left of it.",
              "$ref": "#/$defs/decimal"
            }
          }
        },
        "contextCallers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^system:serviceaccount:[a-z0-9-]+:[a-z0-9-]+$"
          }
        }
      }
    },
    "syntheticPrices": {
      "description": "The price sheet of the control service's estimates.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimateValiditySeconds",
        "skuPrices",
        "runtimeProfiles"
      ],
      "properties": {
        "estimateValiditySeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "skuPrices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ServiceProviderName",
              "SkuId",
              "SkuPriceId",
              "ChargeCategory",
              "UnitPrice",
              "UnitPriceType",
              "PricingUnit",
              "PricingCurrency",
              "PricingCurrencyCategory",
              "SkuPriceEffectiveStart",
              "SkuPriceEligibility"
            ],
            "properties": {
              "ServiceProviderName": {
                "type": "string",
                "pattern": "\\S",
                "maxLength": 512
              },
              "SkuId": {
                "$ref": "#/$defs/reference"
              },
              "SkuPriceId": {
                "$ref": "#/$defs/reference"
              },
              "ContractId": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/reference"
                  }
                ]
              },
              "ChargeCategory": {
                "const": "Usage"
              },
              "UnitPrice": {
                "$ref": "#/$defs/decimal"
              },
              "UnitPriceType": {
                "enum": [
                  "List",
                  "Base",
                  "Contracted"
                ]
              },
              "PricingUnit": {
                "type": "string",
                "pattern": "\\S",
                "maxLength": 512
              },
              "PricingCurrency": {
                "$ref": "#/$defs/reference"
              },
              "PricingCurrencyCategory": {
                "enum": [
                  "Payable",
                  "Consumable"
                ]
              },
              "SkuPriceEffectiveStart": {
                "$ref": "#/$defs/timestamp"
              },
              "SkuPriceEffectiveEnd": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/timestamp"
                  }
                ]
              },
              "SkuPriceEligibility": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "IsGlobalScope"
                ],
                "properties": {
                  "IsGlobalScope": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        "runtimeProfiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "runtimeProfileRef",
              "kind",
              "rates"
            ],
            "properties": {
              "runtimeProfileRef": {
                "$ref": "#/$defs/reference"
              },
              "kind": {
                "enum": [
                  "exploration",
                  "batch",
                  "inference"
                ]
              },
              "rates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "measure",
                    "skuPriceId",
                    "quantityPerPricingUnit"
                  ],
                  "properties": {
                    "measure": {
                      "enum": [
                        "duration",
                        "task_duration",
                        "input_tokens",
                        "output_tokens"
                      ]
                    },
                    "skuPriceId": {
                      "$ref": "#/$defs/reference"
                    },
                    "quantityPerPricingUnit": {
                      "$ref": "#/$defs/decimal"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "researchers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "username"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "username": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          }
        }
      }
    },
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicOrigin",
        "trustedProxySources",
        "storage",
        "resources",
        "worker",
        "modelRoute"
      ],
      "properties": {
        "publicOrigin": {
          "description": "HTTPS scheme, DNS host name and optional port of the Hub's proxy.",
          "type": "string",
          "pattern": "^https://[a-z0-9.-]*[a-z][a-z0-9.-]*(:[0-9]{1,5})?$"
        },
        "trustedProxySources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f.:]+/[0-9]{1,3}$"
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capacity",
            "storageClassName"
          ],
          "properties": {
            "capacity": {
              "type": "string"
            },
            "storageClassName": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpuLimit",
            "cpuGuarantee",
            "memoryLimit",
            "memoryGuarantee"
          ],
          "properties": {
            "cpuLimit": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cpuGuarantee": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "memoryLimit": {
              "type": "string",
              "pattern": "^[1-9][0-9]*[KMG]$"
            },
            "memoryGuarantee": {
              "type": "string",
              "pattern": "^[1-9][0-9]*[KMG]$"
            }
          }
        },
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image",
            "policy",
            "cpu",
            "memory"
          ],
          "properties": {
            "image": {
              "description": "The worker image by digest, or empty until it is set.",
              "anyOf": [
                {
                  "$ref": "#/$defs/image"
                },
                {
                  "const": ""
                }
              ]
            },
            "policy": {
              "type": "object"
            },
            "cpu": {
              "type": "string",
              "pattern": "^[1-9][0-9]*m?$"
            },
            "memory": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi)$"
            }
          }
        },
        "modelRoute": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profileId",
            "model",
            "provider",
            "placeholderEnv",
            "binaries",
            "dataHandling"
          ],
          "properties": {
            "profileId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            },
            "model": {
              "description": "A name of inference.models; empty selects the first.",
              "type": "string",
              "pattern": "^([A-Za-z0-9][A-Za-z0-9._-]{0,127})?$"
            },
            "provider": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
            },
            "placeholderEnv": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "binaries": {
              "description": "Programs of the worker image that may send the key, by resolved path; the chart refuses an empty list.",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^/\\S+$"
              }
            },
            "dataHandling": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "destination",
                "retentionAuthority",
                "route"
              ],
              "properties": {
                "destination": {
                  "enum": [
                    "same-compute",
                    "institution-managed",
                    "provider",
                    "operator-defined"
                  ]
                },
                "retentionAuthority": {
                  "enum": [
                    "deployment",
                    "institution",
                    "provider",
                    "service-operator"
                  ]
                },
                "route": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    },
    "jupyterhub": {
      "description": "Values of the JupyterHub chart.",
      "type": "object"
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "models",
        "environment",
        "trustPublicRoots",
        "settleWaitSeconds",
        "syntheticModel",
        "localModel"
      ],
      "properties": {
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "maxInputTokens",
              "maxOutputTokens",
              "litellmParams"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "maxInputTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000000
              },
              "maxOutputTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000000
              },
              "supportsToolCalls": {
                "type": "boolean"
              },
              "litellmParams": {
                "description": "LiteLLM parameters of the model; api_key is set from apiKeySecret.",
                "type": "object",
                "required": [
                  "model"
                ],
                "not": {
                  "required": [
                    "api_key"
                  ]
                }
              },
              "apiKeySecret": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "key"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                  },
                  "key": {
                    "type": "string",
                    "pattern": "^[-._a-zA-Z0-9]+$"
                  }
                }
              }
            }
          }
        },
        "environment": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "secretKeyRef"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$",
                "not": {
                  "pattern": "^(LITELLM_|DATABASE_URL$|HW_MODEL_KEY_)"
                }
              },
              "secretKeyRef": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "key"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                  },
                  "key": {
                    "type": "string",
                    "pattern": "^[-._a-zA-Z0-9]+$"
                  }
                }
              }
            }
          }
        },
        "trustPublicRoots": {
          "type": "boolean"
        },
        "settleWaitSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "syntheticModel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "localModel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "alias",
            "model",
            "contextSize",
            "threads",
            "resources"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "alias": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "model": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "sha256",
                "maxBytes"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^(https://\\S+)?$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{64})?$"
                },
                "maxBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8589934592
                }
              }
            },
            "contextSize": {
              "type": "integer",
              "minimum": 256,
              "maximum": 1048576
            },
            "threads": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*m?$"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(Mi|Gi)$"
                }
              }
            }
          }
        }
      }
    },
    "jobs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor",
        "storage",
        "executorStorage",
        "workspaceStorage",
        "taskImages",
        "startDeadlineSeconds",
        "quota",
        "limits",
        "drsHost"
      ],
      "properties": {
        "executor": {
          "description": "The TES executor of the job service.",
          "enum": [
            "funnel"
          ]
        },
        "storage": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|M|Mi|G|Gi|T|Ti)?$"
        },
        "executorStorage": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|M|Mi|G|Gi|T|Ti)?$"
        },
        "workspaceStorage": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|M|Mi|G|Gi|T|Ti)?$"
        },
        "taskImages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/image"
          }
        },
        "startDeadlineSeconds": {
          "type": "integer",
          "minimum": 30
        },
        "quota": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxCpuCores",
            "maxRamGb",
            "maxDiskGb",
            "maxRuntimeSeconds",
            "maxGpuCount",
            "maxActiveTasks"
          ],
          "properties": {
            "maxCpuCores": {
              "type": "integer",
              "minimum": 1
            },
            "maxRamGb": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "maxDiskGb": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "maxRuntimeSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "maxGpuCount": {
              "type": "integer",
              "minimum": 0
            },
            "maxActiveTasks": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "drsHost": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+(:[0-9]+)?$"
        }
      }
    }
  }
}
