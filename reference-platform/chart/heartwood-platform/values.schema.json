{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Values of the Heartwood reference platform chart",
  "type": "object",
  "additionalProperties": false,
  "required": ["images", "projects", "postgresql", "keycloak", "versitygw", "sessions"],
  "$defs": {
    "image": {
      "description": "An image reference pinned by digest.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/:-]*@sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$"
    }
  },
  "properties": {
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["postgresql", "keycloak", "versitygw"],
      "properties": {
        "postgresql": {"$ref": "#/$defs/image"},
        "keycloak": {"$ref": "#/$defs/image"},
        "versitygw": {"$ref": "#/$defs/image"}
      }
    },
    "storageClassName": {"type": "string"},
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {"id": {"$ref": "#/$defs/identifier"}}
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage"],
      "properties": {"storage": {"type": "string"}}
    },
    "keycloak": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"url": {"type": "string", "pattern": "^(https?://[^/]+)?$"}}
    },
    "versitygw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage"],
      "properties": {"storage": {"type": "string"}}
    },
    "sessions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "stagingImage", "attemptStorageClass"],
      "properties": {
        "namespace": {"$ref": "#/$defs/identifier"},
        "stagingImage": {"anyOf": [{"const": ""}, {"$ref": "#/$defs/image"}]},
        "attemptStorageClass": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provisioner"],
          "properties": {
            "provisioner": {"type": "string"},
            "parameters": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        }
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
        "tolerations": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
