+// transportCredentials returns TLS credentials when the client is configured
+// for TLS, and nil for plaintext.
+func transportCredentials(conf *config.RPCClient) (credentials.TransportCredentials, error) {
+	if !conf.GetTLS() && conf.GetTLSCAFile() == "" {
+		if conf.GetTLSServerName() != "" {
+			return nil, fmt.Errorf("rpc: RPCClient.TLSServerName is set but TLS is not enabled")
+		}
+		return nil, nil
+	}
+	tlsConf := &tls.Config{MinVersion: tls.VersionTLS12, ServerName: conf.GetTLSServerName()}
+	if path := conf.GetTLSCAFile(); path != "" {
+		pem, err := os.ReadFile(path)
+		if err != nil {
+			return nil, fmt.Errorf("rpc: reading RPCClient.TLSCAFile: %w", err)
+		}
+		tlsConf.RootCAs = x509.NewCertPool()
+		if !tlsConf.RootCAs.AppendCertsFromPEM(pem) {
+			return nil, fmt.Errorf("rpc: RPCClient.TLSCAFile %q contains no PEM certificate", path)
+		}
+	}
+	return credentials.NewTLS(tlsConf), nil
+}
