diff --git a/internal/server/tls.go b/internal/server/tls.go
new file mode 100644
index 0000000..6ae6c69
--- /dev/null
+++ b/internal/server/tls.go
@@ -0,0 +1,43 @@
+package server
+
+import (
+	"bytes"
+	"crypto/tls"
+	"errors"
+	"fmt"
+
+	"google.golang.org/grpc/credentials"
+	"google.golang.org/grpc/credentials/insecure"
+)
+
+// loadTLS reads the server certificate. It returns the listener configuration
+// and the credentials the HTTP gateway uses to reach the gRPC listener in the
+// same process. Without a certificate both listeners stay plaintext.
+func loadTLS(certFile, keyFile string) (*tls.Config, credentials.TransportCredentials, error) {
+	if certFile == "" && keyFile == "" {
+		return nil, insecure.NewCredentials(), nil
+	}
+	if certFile == "" || keyFile == "" {
+		return nil, nil, errors.New("Server.TLSCertFile and Server.TLSKeyFile must be set together")
+	}
+	cert, err := tls.LoadX509KeyPair(certFile, keyFile)
+	if err != nil {
+		return nil, nil, fmt.Errorf("loading Server.TLSCertFile and Server.TLSKeyFile: %w", err)
+	}
+	serverTLS := &tls.Config{Certificates: []tls.Certificate{cert}, MinVersion: tls.VersionTLS12}
+
+	// The gateway dials the listen address, which need not match a name in the
+	// certificate, so it accepts exactly the certificate this process serves.
+	leaf := cert.Certificate[0]
+	gatewayTLS := &tls.Config{
+		MinVersion:         tls.VersionTLS12,
+		InsecureSkipVerify: true, // Verification is done by VerifyConnection below.
+		VerifyConnection: func(state tls.ConnectionState) error {
+			if len(state.PeerCertificates) == 0 || !bytes.Equal(state.PeerCertificates[0].Raw, leaf) {
+				return errors.New("gateway: gRPC listener presented an unexpected certificate")
+			}
+			return nil
+		},
+	}
+	return serverTLS, credentials.NewTLS(gatewayTLS), nil
+}
diff --git a/internal/server/tls_test.go b/internal/server/tls_test.go
new file mode 100644
index 0000000..7ea9ea1
--- /dev/null
+++ b/internal/server/tls_test.go
@@ -0,0 +1,278 @@
+package server
+
+import (
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"io"
+	"math/big"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/calypr/funnel/api/config"
+	"github.com/calypr/funnel/api/tes"
+	"github.com/calypr/funnel/internal/server/taskservice"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/credentials"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/grpc/health"
+	healthpb "google.golang.org/grpc/health/grpc_health_v1"
+	"google.golang.org/grpc/status"
+)
+
+// writeTestCertificate writes a CA-signed certificate for 127.0.0.1 and its key
+// into a temporary directory and returns their paths and the CA pool.
+func writeTestCertificate(t *testing.T) (certFile, keyFile string, roots *x509.CertPool) {
+	t.Helper()
+	newKey := func() *ecdsa.PrivateKey {
+		key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return key
+	}
+	caKey, leafKey := newKey(), newKey()
+	caTemplate := &x509.Certificate{
+		SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "test CA"},
+		NotBefore: time.Now().Add(-time.Minute), NotAfter: time.Now().Add(time.Hour),
+		IsCA: true, BasicConstraintsValid: true, KeyUsage: x509.KeyUsageCertSign,
+	}
+	caDER, err := x509.CreateCertificate(rand.Reader, caTemplate, caTemplate, &caKey.PublicKey, caKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ca, err := x509.ParseCertificate(caDER)
+	if err != nil {
+		t.Fatal(err)
+	}
+	leafTemplate := &x509.Certificate{
+		SerialNumber: big.NewInt(2), Subject: pkix.Name{CommonName: "funnel"},
+		NotBefore: time.Now().Add(-time.Minute), NotAfter: time.Now().Add(time.Hour),
+		KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+		IPAddresses: []net.IP{net.ParseIP("127.0.0.1")},
+	}
+	leafDER, err := x509.CreateCertificate(rand.Reader, leafTemplate, ca, &leafKey.PublicKey, caKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	keyDER, err := x509.MarshalECPrivateKey(leafKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	dir := t.TempDir()
+	certFile, keyFile = filepath.Join(dir, "tls.crt"), filepath.Join(dir, "tls.key")
+	for path, block := range map[string]*pem.Block{
+		certFile: {Type: "CERTIFICATE", Bytes: leafDER},
+		keyFile:  {Type: "EC PRIVATE KEY", Bytes: keyDER},
+	} {
+		if err := os.WriteFile(path, pem.EncodeToMemory(block), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	roots = x509.NewCertPool()
+	roots.AddCert(ca)
+	return certFile, keyFile, roots
+}
+
+// serveTLS runs s until the test ends and waits until it answers over HTTPS.
+// It returns a client that trusts roots and the HTTPS base URL.
+func serveTLS(t *testing.T, s *Server, roots *x509.CertPool) (*http.Client, string) {
+	t.Helper()
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	client := &http.Client{Timeout: time.Second, Transport: &http.Transport{TLSClientConfig: &tls.Config{RootCAs: roots, MinVersion: tls.VersionTLS12}}}
+	go func() { done <- s.Serve(ctx) }()
+	t.Cleanup(func() {
+		client.CloseIdleConnections()
+		cancel()
+		select {
+		case err := <-done:
+			if err != nil {
+				t.Errorf("server stopped: %v", err)
+			}
+		case <-time.After(5 * time.Second):
+			t.Error("server did not stop")
+		}
+	})
+	base := "https://127.0.0.1:" + s.HTTPPort
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		_, _, err := get(client, base+"/healthz")
+		if err == nil {
+			return client, base
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("server did not start: %v", err)
+		}
+		time.Sleep(25 * time.Millisecond)
+	}
+}
+
+func get(client *http.Client, url string) (int, string, error) {
+	req, err := http.NewRequest(http.MethodGet, url, nil)
+	if err != nil {
+		return 0, "", err
+	}
+	return do(client, req)
+}
+
+func do(client *http.Client, req *http.Request) (int, string, error) {
+	resp, err := client.Do(req)
+	if err != nil {
+		return 0, "", err
+	}
+	defer resp.Body.Close() //nolint:errcheck // Read-only HTTP response cleanup cannot change the test assertions.
+	body, err := io.ReadAll(resp.Body)
+	return resp.StatusCode, string(body), err
+}
+
+func TestServeTLSOnBothListeners(t *testing.T) {
+	certFile, keyFile, roots := writeTestCertificate(t)
+	rpcAddress := freeTCPAddress(t)
+	httpPort := strconv.Itoa(tcpPort(t))
+	s := newTestServer(rpcAddress, httpPort)
+	s.TLSCertFile, s.TLSKeyFile = certFile, keyFile
+	s.Tasks = &taskservice.Service{Read: &responseViewReader{task: &tes.Task{Id: "task-1", State: tes.Running}}, Log: s.Log}
+	client, base := serveTLS(t, s, roots)
+
+	// The gateway reaches the gRPC listener over TLS.
+	code, body, err := get(client, base+"/v1/tasks/task-1")
+	if err != nil || code != http.StatusOK || !strings.Contains(body, "RUNNING") {
+		t.Fatalf("task over HTTPS: status=%d body=%s err=%v", code, body, err)
+	}
+
+	// A client that does not trust the CA fails the handshake.
+	untrusting := &http.Client{Timeout: time.Second, Transport: &http.Transport{TLSClientConfig: &tls.Config{RootCAs: x509.NewCertPool(), MinVersion: tls.VersionTLS12}}}
+	defer untrusting.CloseIdleConnections()
+	if _, _, err := get(untrusting, base+"/healthz"); err == nil {
+		t.Fatal("client without the CA completed a request")
+	}
+
+	// Plaintext HTTP is not served.
+	plain := &http.Client{Timeout: time.Second, Transport: &http.Transport{}}
+	defer plain.CloseIdleConnections()
+	code, _, err = get(plain, "http://127.0.0.1:"+httpPort+"/healthz")
+	if err == nil && code == http.StatusOK {
+		t.Fatal("plaintext HTTP request succeeded on the TLS listener")
+	}
+
+	// Plaintext gRPC is not served.
+	conn, err := grpc.NewClient(rpcAddress, grpc.WithTransportCredentials(insecure.NewCredentials()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close() //nolint:errcheck // Best-effort cleanup of the test connection.
+	callCtx, callCancel := context.WithTimeout(t.Context(), 2*time.Second)
+	defer callCancel()
+	var task tes.Task
+	err = conn.Invoke(callCtx, "/tes.TaskService/GetTask", &tes.GetTaskRequest{Id: "task-1"}, &task)
+	if err == nil {
+		t.Fatal("plaintext gRPC call succeeded on the TLS listener")
+	}
+}
+
+func TestServeTLSWithBasicAuth(t *testing.T) {
+	certFile, keyFile, roots := writeTestCertificate(t)
+	// The production form of the RPC address has no host.
+	rpcPort := strconv.Itoa(tcpPort(t))
+	s := newTestServer(":"+rpcPort, strconv.Itoa(tcpPort(t)))
+	s.TLSCertFile, s.TLSKeyFile = certFile, keyFile
+	s.BasicAuth = []*config.BasicCredential{{User: "alice", Password: "synthetic"}}
+	s.Tasks = &taskservice.Service{Read: &responseViewReader{task: &tes.Task{Id: "task-1", State: tes.Running}}, Log: s.Log}
+	client, base := serveTLS(t, s, roots)
+
+	req, err := http.NewRequest(http.MethodGet, base+"/v1/tasks/task-1", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if code, body, err := do(client, req); err != nil || code != http.StatusUnauthorized {
+		t.Fatalf("task over HTTPS without credentials: status=%d body=%s err=%v", code, body, err)
+	}
+	req.SetBasicAuth("alice", "synthetic")
+	if code, body, err := do(client, req); err != nil || code != http.StatusOK || !strings.Contains(body, "RUNNING") {
+		t.Fatalf("task over HTTPS with credentials: status=%d body=%s err=%v", code, body, err)
+	}
+
+	// A direct gRPC call over TLS still requires credentials.
+	conn, err := grpc.NewClient("127.0.0.1:"+rpcPort, grpc.WithTransportCredentials(credentials.NewTLS(&tls.Config{RootCAs: roots, MinVersion: tls.VersionTLS12})))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close() //nolint:errcheck // Best-effort cleanup of the test connection.
+	callCtx, callCancel := context.WithTimeout(t.Context(), 2*time.Second)
+	defer callCancel()
+	var task tes.Task
+	err = conn.Invoke(callCtx, "/tes.TaskService/GetTask", &tes.GetTaskRequest{Id: "task-1"}, &task)
+	if status.Code(err) != codes.Unauthenticated {
+		t.Fatalf("gRPC call over TLS without credentials: %v", err)
+	}
+}
+
+func TestGatewayCredentialsPinServedCertificate(t *testing.T) {
+	certFile, keyFile, _ := writeTestCertificate(t)
+	otherCertFile, otherKeyFile, _ := writeTestCertificate(t)
+	_, gatewayCredentials, err := loadTLS(certFile, keyFile)
+	if err != nil {
+		t.Fatal(err)
+	}
+	healthCheck := func(serverCertFile, serverKeyFile string) error {
+		serverTLS, _, err := loadTLS(serverCertFile, serverKeyFile)
+		if err != nil {
+			t.Fatal(err)
+		}
+		listener, err := net.Listen("tcp", "127.0.0.1:0")
+		if err != nil {
+			t.Fatal(err)
+		}
+		server := grpc.NewServer(grpc.Creds(credentials.NewTLS(serverTLS)))
+		healthpb.RegisterHealthServer(server, health.NewServer())
+		go server.Serve(listener) //nolint:errcheck // Stop below ends Serve.
+		defer server.Stop()
+		conn, err := grpc.NewClient(listener.Addr().String(), grpc.WithTransportCredentials(gatewayCredentials))
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer conn.Close() //nolint:errcheck // Best-effort cleanup of the test connection.
+		ctx, cancel := context.WithTimeout(t.Context(), 2*time.Second)
+		defer cancel()
+		_, err = healthpb.NewHealthClient(conn).Check(ctx, &healthpb.HealthCheckRequest{})
+		return err
+	}
+	if err := healthCheck(otherCertFile, otherKeyFile); err == nil || !strings.Contains(err.Error(), "unexpected certificate") {
+		t.Fatalf("gateway credentials with a different certificate: %v", err)
+	}
+	if err := healthCheck(certFile, keyFile); err != nil {
+		t.Fatalf("gateway credentials with the served certificate: %v", err)
+	}
+}
+
+func TestLoadTLSRequiresCertificateAndKey(t *testing.T) {
+	certFile, keyFile, _ := writeTestCertificate(t)
+	for _, tc := range []struct{ name, cert, key string }{
+		{"key only", "", keyFile},
+		{"certificate only", certFile, ""},
+		{"missing file", certFile, filepath.Join(t.TempDir(), "absent.key")},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if _, _, err := loadTLS(tc.cert, tc.key); err == nil {
+				t.Fatal("incomplete TLS configuration accepted")
+			}
+		})
+	}
+	serverTLS, _, err := loadTLS("", "")
+	if err != nil || serverTLS != nil {
+		t.Fatalf("TLS without configuration = %v, %v; want plaintext", serverTLS, err)
+	}
+}
diff --git a/website/config.yaml b/website/config.yaml
index a858cbd..565e3bc 100644
--- a/website/config.yaml
