diff --git a/internal/rpcclient/tls_test.go b/internal/rpcclient/tls_test.go
new file mode 100644
index 0000000..d2ad899
--- /dev/null
+++ b/internal/rpcclient/tls_test.go
@@ -0,0 +1,246 @@
+package rpcclient
+
+import (
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"math/big"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/calypr/funnel/api/config"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/credentials"
+	"google.golang.org/grpc/credentials/insecure"
+	healthpb "google.golang.org/grpc/health/grpc_health_v1"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/grpc/status"
+)
+
+type healthServer struct {
+	healthpb.UnimplementedHealthServer
+	authorization chan string
+}
+
+func (h *healthServer) Check(ctx context.Context, _ *healthpb.HealthCheckRequest) (*healthpb.HealthCheckResponse, error) {
+	md, _ := metadata.FromIncomingContext(ctx)
+	if values := md.Get("authorization"); len(values) > 0 {
+		h.authorization <- values[0]
+	}
+	return &healthpb.HealthCheckResponse{Status: healthpb.HealthCheckResponse_SERVING}, nil
+}
+
+// startTLSServer serves the health service over TLS with a certificate for
+// 127.0.0.1 and "funnel.test", and returns its address, the CA file and the
+// channel that receives each Authorization header.
+func startTLSServer(t *testing.T) (address, caFile string, authorization chan string) {
+	t.Helper()
+	newKey := func() *ecdsa.PrivateKey {
+		key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return key
+	}
+	caKey, leafKey := newKey(), newKey()
+	caTemplate := &x509.Certificate{
+		SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "test CA"},
+		NotBefore: time.Now().Add(-time.Minute), NotAfter: time.Now().Add(time.Hour),
+		IsCA: true, BasicConstraintsValid: true, KeyUsage: x509.KeyUsageCertSign,
+	}
+	caDER, err := x509.CreateCertificate(rand.Reader, caTemplate, caTemplate, &caKey.PublicKey, caKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ca, err := x509.ParseCertificate(caDER)
+	if err != nil {
+		t.Fatal(err)
+	}
+	leafTemplate := &x509.Certificate{
+		SerialNumber: big.NewInt(2), Subject: pkix.Name{CommonName: "funnel"},
+		NotBefore: time.Now().Add(-time.Minute), NotAfter: time.Now().Add(time.Hour),
+		KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+		IPAddresses: []net.IP{net.ParseIP("127.0.0.1")}, DNSNames: []string{"funnel.test"},
+	}
+	leafDER, err := x509.CreateCertificate(rand.Reader, leafTemplate, ca, &leafKey.PublicKey, caKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	caFile = filepath.Join(t.TempDir(), "ca.crt")
+	if err := os.WriteFile(caFile, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: caDER}), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	address, authorization = startHealthServer(t, grpc.Creds(credentials.NewTLS(&tls.Config{
+		Certificates: []tls.Certificate{{Certificate: [][]byte{leafDER}, PrivateKey: leafKey}},
+		MinVersion:   tls.VersionTLS12,
+	})))
+	return address, caFile, authorization
+}
+
+// startHealthServer serves the health service on 127.0.0.1, in plaintext
+// unless opts set credentials, and returns its address and the channel that
+// receives each Authorization header.
+func startHealthServer(t *testing.T, opts ...grpc.ServerOption) (address string, authorization chan string) {
+	t.Helper()
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	authorization = make(chan string, 8)
+	server := grpc.NewServer(opts...)
+	healthpb.RegisterHealthServer(server, &healthServer{authorization: authorization})
+	go server.Serve(listener) //nolint:errcheck // Stop below ends Serve.
+	t.Cleanup(server.Stop)
+	return listener.Addr().String(), authorization
+}
+
+func check(t *testing.T, conf *config.RPCClient, opts ...grpc.DialOption) error {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	conn, err := Dial(ctx, conf, opts...)
+	if err != nil {
+		return err
+	}
+	defer conn.Close() //nolint:errcheck // Best-effort cleanup of the test connection.
+	_, err = healthpb.NewHealthClient(conn).Check(ctx, &healthpb.HealthCheckRequest{})
+	return err
+}
+
+// receive waits briefly for the Authorization header the server received.
+func receive(t *testing.T, authorization chan string) string {
+	t.Helper()
+	select {
+	case got := <-authorization:
+		return got
+	case <-time.After(2 * time.Second):
+		t.Fatal("no request reached the server")
+		return ""
+	}
+}
+
+// drain discards headers left behind by an earlier failed subtest.
+func drain(channels ...chan string) {
+	for _, ch := range channels {
+		for len(ch) > 0 {
+			<-ch
+		}
+	}
+}
+
+func TestDialTLS(t *testing.T) {
+	// Credentials to 127.0.0.1 and localhost are permitted without TLS. The
+	// funnel.test cases use a remote name, where only TLS permits credentials.
+	t.Setenv("FUNNEL_ALLOW_INSECURE_CREDENTIALS", "")
+	address, caFile, authorization := startTLSServer(t)
+	plainAddress, plainAuthorization := startHealthServer(t)
+	_, port, err := net.SplitHostPort(address)
+	if err != nil {
+		t.Fatal(err)
+	}
+	credential := &config.BasicCredential{User: "u", Password: "p"}
+	insecureOption := grpc.WithTransportCredentials(insecure.NewCredentials())
+	// Resolves funnel.test to the TLS listener.
+	remoteDialer := grpc.WithContextDialer(func(ctx context.Context, _ string) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, "tcp", address)
+	})
+
+	for _, tc := range []struct {
+		name string
+		conf *config.RPCClient
+		opts []grpc.DialOption
+	}{
+		{"verified with the CA", &config.RPCClient{ServerAddress: address, Credential: credential, TLSCAFile: caFile}, nil},
+		{"server name override", &config.RPCClient{ServerAddress: address, Credential: credential, TLSCAFile: caFile, TLSServerName: "funnel.test"}, nil},
+		{"insecure option does not downgrade", &config.RPCClient{ServerAddress: address, Credential: credential, TLSCAFile: caFile}, []grpc.DialOption{insecureOption}},
+		// The server name defaults to funnel.test from the address.
+		{"credentials to a remote address over TLS", &config.RPCClient{ServerAddress: "funnel.test:" + port, Credential: credential, TLSCAFile: caFile}, []grpc.DialOption{remoteDialer}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			drain(authorization)
+			if err := check(t, tc.conf, tc.opts...); err != nil {
+				t.Fatal(err)
+			}
+			if got := receive(t, authorization); got != "Basic dTpw" {
+				t.Fatalf("Authorization = %q", got)
+			}
+		})
+	}
+	t.Run("credentials to a remote address without TLS", func(t *testing.T) {
+		conf := &config.RPCClient{ServerAddress: "funnel.test:" + port, Credential: credential}
+		err := check(t, conf, remoteDialer)
+		if err == nil || !strings.Contains(err.Error(), "refusing credentials") {
+			t.Fatalf("Dial error = %v; want refusing credentials", err)
+		}
+	})
+	for _, tc := range []struct {
+		name          string
+		conf          *config.RPCClient
+		opts          []grpc.DialOption
+		authorization chan string
+		reason        string
+	}{
+		{"without the CA", &config.RPCClient{ServerAddress: address, Credential: credential, TLS: true}, nil, authorization, "unknown authority"},
+		{"wrong server name", &config.RPCClient{ServerAddress: address, Credential: credential, TLSCAFile: caFile, TLSServerName: "other.test"}, nil, authorization, "certificate is valid for"},
+		// The certificate is valid for 127.0.0.1 and funnel.test only.
+		{"default server name from the host", &config.RPCClient{ServerAddress: "localhost:" + port, Credential: credential, TLSCAFile: caFile}, nil, authorization, "certificate is valid for"},
+		{"plaintext to a TLS server", &config.RPCClient{ServerAddress: "localhost:" + port, Credential: credential}, nil, authorization, "server preface"},
+		{"TLS to a plaintext server", &config.RPCClient{ServerAddress: plainAddress, Credential: credential, TLSCAFile: caFile}, nil, plainAuthorization, "first record does not look like a TLS handshake"},
+		{"insecure option to a plaintext server", &config.RPCClient{ServerAddress: plainAddress, Credential: credential, TLSCAFile: caFile}, []grpc.DialOption{insecureOption}, plainAuthorization, "first record does not look like a TLS handshake"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			// The override for plaintext credentials does not weaken TLS.
+			for _, allowInsecure := range []string{"", "true"} {
+				t.Setenv("FUNNEL_ALLOW_INSECURE_CREDENTIALS", allowInsecure)
+				drain(authorization, plainAuthorization)
+				err := check(t, tc.conf, tc.opts...)
+				if status.Code(err) != codes.Unavailable || !strings.Contains(err.Error(), tc.reason) {
+					t.Fatalf("FUNNEL_ALLOW_INSECURE_CREDENTIALS=%q: error = %v; want Unavailable with %q", allowInsecure, err, tc.reason)
+				}
+				// The failed handshake is the proof; this also confirms that
+				// no request reached the server.
+				select {
+				case got := <-tc.authorization:
+					t.Fatalf("credential reached the server with FUNNEL_ALLOW_INSECURE_CREDENTIALS=%q: %q", allowInsecure, got)
+				default:
+				}
+			}
+		})
+	}
+}
+
+func TestDialTLSConfigurationErrors(t *testing.T) {
+	empty := filepath.Join(t.TempDir(), "empty.crt")
+	if err := os.WriteFile(empty, []byte("not a certificate"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name string
+		conf *config.RPCClient
+	}{
+		{"missing CA file", &config.RPCClient{ServerAddress: "remote.invalid:9090", TLSCAFile: filepath.Join(t.TempDir(), "absent.crt")}},
+		{"CA file without certificates", &config.RPCClient{ServerAddress: "remote.invalid:9090", TLSCAFile: empty}},
+		{"server name without TLS", &config.RPCClient{ServerAddress: "remote.invalid:9090", TLSServerName: "funnel.test"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			conn, err := Dial(context.Background(), tc.conf)
+			if conn != nil {
+				conn.Close() //nolint:errcheck // Best-effort cleanup of an unexpected connection.
+			}
+			if err == nil {
+				t.Fatal("invalid TLS configuration accepted")
+			}
+		})
+	}
+}
