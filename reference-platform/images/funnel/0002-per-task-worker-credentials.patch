--- /dev/null
+++ b/internal/server/auth/task_worker.go
@@ -0,0 +1,77 @@
+package auth
+
+import (
+	"context"
+	"encoding/base64"
+	"strings"
+
+	"github.com/calypr/funnel/api/tes"
+	"github.com/calypr/funnel/internal/events"
+	"github.com/calypr/funnel/internal/identity"
+	"github.com/calypr/funnel/internal/taskcred"
+	"github.com/calypr/funnel/internal/tesrpc"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+var errTaskWorkerDenied = status.Error(codes.PermissionDenied, "worker credentials may only read, claim and report their own task")
+
+// EnableTaskCredentials makes the interceptor accept worker credentials
+// derived from key, each limited to its own task.
+func (a *Authentication) EnableTaskCredentials(key []byte) {
+	a.taskKey = key
+}
+
+// verifyTaskCredential returns the task ID bound to a Basic authorization
+// header value, if it carries a valid worker credential.
+func (a *Authentication) verifyTaskCredential(authorization string) (string, bool) {
+	if a.taskKey == nil {
+		return "", false
+	}
+	decoded, err := base64.StdEncoding.DecodeString(strings.TrimPrefix(authorization, "Basic "))
+	if err != nil {
+		return "", false
+	}
+	user, password, ok := strings.Cut(string(decoded), ":")
+	if !ok {
+		return "", false
+	}
+	return taskcred.Verify(a.taskKey, user, password)
+}
+
+// handleTaskWorker authorizes a request made with the worker credential of
+// taskID: it may read its task, claim its execution and write events to it.
+func (a *Authentication) handleTaskWorker(
+	ctx context.Context, taskID string, req interface{}, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler,
+) (interface{}, error) {
+	username := taskcred.Username(taskID)
+	if target, ok := taskWorkerTarget(info.FullMethod, req); !ok || target != taskID {
+		logAuditEntry(a.log, info.FullMethod, username, target, errTaskWorkerDenied)
+		return nil, errTaskWorkerDenied
+	}
+	// The check above limits every permitted request to this task, so the
+	// task owner rules of Server.TaskAccess do not apply.
+	ctx = identity.WithUser(ctx, &identity.UserInfo{Username: username, AccessMode: identity.AccessAll})
+	return handler(ctx, req)
+}
+
+// taskWorkerTarget returns the task a request made with a worker credential
+// refers to, and false for requests a worker credential may not make.
+func taskWorkerTarget(method string, req interface{}) (string, bool) {
+	switch method {
+	case tesrpc.TaskService_GetTask_FullMethodName:
+		r, ok := req.(*tes.GetTaskRequest)
+		return r.GetId(), ok
+	case events.EventService_ClaimExecution_FullMethodName:
+		r, ok := req.(*events.ClaimExecutionRequest)
+		return r.GetTaskId(), ok
+	case events.EventService_WriteEvent_FullMethodName:
+		r, ok := req.(*events.Event)
+		if !ok || r.GetType() == events.Type_TASK_CREATED || r.GetTask() != nil {
+			return r.GetId(), false
+		}
+		return r.GetId(), true
+	}
+	return "", false
+}
