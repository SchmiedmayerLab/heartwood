@@ -0,0 +1,165 @@
+package auth
+
+import (
+	"context"
+	"encoding/base64"
+	"strings"
+	"testing"
+
+	"github.com/calypr/funnel/api/config"
+	"github.com/calypr/funnel/api/tes"
+	"github.com/calypr/funnel/internal/compute/scheduler"
+	"github.com/calypr/funnel/internal/events"
+	"github.com/calypr/funnel/internal/identity"
+	"github.com/calypr/funnel/internal/taskcred"
+	"github.com/calypr/funnel/internal/tesrpc"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/grpc/status"
+)
+
+var workerKey = []byte("0123456789abcdef0123456789abcdef")
+
+func basicContext(user, password string) context.Context {
+	value := "Basic " + base64.StdEncoding.EncodeToString([]byte(user+":"+password))
+	return metadata.NewIncomingContext(context.Background(), metadata.Pairs("authorization", value))
+}
+
+func workerContext(taskID string) context.Context {
+	return basicContext(taskcred.Username(taskID), taskcred.Password(workerKey, taskID))
+}
+
+type call struct {
+	method string
+	req    interface{}
+}
+
+func callInterceptor(auth *Authentication, ctx context.Context, c call) (*identity.UserInfo, error) {
+	var user *identity.UserInfo
+	_, err := auth.Interceptor(ctx, c.req, &grpc.UnaryServerInfo{FullMethod: c.method},
+		func(ctx context.Context, _ interface{}) (interface{}, error) {
+			user = identity.GetUser(ctx)
+			return nil, nil
+		})
+	return user, err
+}
+
+func TestTaskWorkerAllowedCalls(t *testing.T) {
+	for _, access := range []string{identity.AccessAll, identity.AccessOwner, identity.AccessOwnerOrAdmin} {
+		auth := NewAuthentication([]*config.BasicCredential{{User: "jobsvc", Password: "synthetic", Admin: true}}, nil, access, nil)
+		auth.EnableTaskCredentials(workerKey)
+		allowed := []call{
+			{tesrpc.TaskService_GetTask_FullMethodName, &tes.GetTaskRequest{Id: "task1", View: "FULL"}},
+			{tesrpc.TaskService_GetTask_FullMethodName, &tes.GetTaskRequest{Id: "task1", View: "MINIMAL"}},
+			{events.EventService_ClaimExecution_FullMethodName, &events.ClaimExecutionRequest{TaskId: "task1"}},
+			{events.EventService_WriteEvent_FullMethodName, events.NewState("task1", tes.Running)},
+			{events.EventService_WriteEvent_FullMethodName, events.NewState("task1", tes.Complete)},
+			{events.EventService_WriteEvent_FullMethodName, events.NewState("task1", tes.Canceled)},
+			{events.EventService_WriteEvent_FullMethodName, events.NewSystemLog("task1", 0, 0, "info", "message", nil)},
+			{events.EventService_WriteEvent_FullMethodName, events.NewExitCode("task1", 0, 0, 0)},
+			// Service info is public.
+			{tesrpc.TaskService_GetServiceInfo_FullMethodName, &tes.GetServiceInfoRequest{}},
+		}
+		for _, c := range allowed {
+			user, err := callInterceptor(auth, workerContext("task1"), c)
+			if err != nil || user == nil {
+				t.Fatalf("%s %s %v: user=%v err=%v", access, c.method, c.req, user, err)
+			}
+			if c.method != tesrpc.TaskService_GetServiceInfo_FullMethodName &&
+				(user.Username != "task/task1" || user.IsAdmin || user.IsPublic || !user.IsAccessible("jobsvc")) {
+				t.Fatalf("%s %s: worker identity %+v", access, c.method, user)
+			}
+		}
+	}
+}
+
+func TestTaskWorkerRefusedCalls(t *testing.T) {
+	auth := NewAuthentication([]*config.BasicCredential{{User: "jobsvc", Password: "synthetic", Admin: true}}, nil, identity.AccessOwnerOrAdmin, nil)
+	auth.EnableTaskCredentials(workerKey)
+	created := events.NewTaskCreated(&tes.Task{Id: "task1"})
+	taskOnState := events.NewState("task1", tes.Running)
+	taskOnState.Data = &events.Event_Task{Task: &tes.Task{Id: "task1"}}
+	refused := map[string]call{
+		"list":                      {tesrpc.TaskService_ListTasks_FullMethodName, &tes.ListTasksRequest{View: "FULL"}},
+		"create":                    {tesrpc.TaskService_CreateTask_FullMethodName, &tes.Task{}},
+		"cancel own":                {tesrpc.TaskService_CancelTask_FullMethodName, &tes.CancelTaskRequest{Id: "task1"}},
+		"cancel other":              {tesrpc.TaskService_CancelTask_FullMethodName, &tes.CancelTaskRequest{Id: "task2"}},
+		"get other":                 {tesrpc.TaskService_GetTask_FullMethodName, &tes.GetTaskRequest{Id: "task2", View: "FULL"}},
+		"get empty id":              {tesrpc.TaskService_GetTask_FullMethodName, &tes.GetTaskRequest{}},
+		"get id prefix":             {tesrpc.TaskService_GetTask_FullMethodName, &tes.GetTaskRequest{Id: "task"}},
+		"claim other":               {events.EventService_ClaimExecution_FullMethodName, &events.ClaimExecutionRequest{TaskId: "task2"}},
+		"canceled event to other":   {events.EventService_WriteEvent_FullMethodName, events.NewState("task2", tes.Canceled)},
+		"system log to other":       {events.EventService_WriteEvent_FullMethodName, events.NewSystemLog("task2", 0, 0, "info", "message", nil)},
+		"outputs to other":          {events.EventService_WriteEvent_FullMethodName, events.NewOutputs("task2", 0, nil)},
+		"task created for own id":   {events.EventService_WriteEvent_FullMethodName, created},
+		"task payload on own event": {events.EventService_WriteEvent_FullMethodName, taskOnState},
+		"put node":                  {"/scheduler.SchedulerService/PutNode", &scheduler.Node{}},
+		"delete node":               {"/scheduler.SchedulerService/DeleteNode", &scheduler.Node{}},
+		"list nodes":                {"/scheduler.SchedulerService/ListNodes", &scheduler.ListNodesRequest{}},
+		"get node":                  {"/scheduler.SchedulerService/GetNode", &scheduler.GetNodeRequest{}},
+		"unknown method":            {"/tes.TaskService/Other", &tes.GetTaskRequest{Id: "task1"}},
+		"mismatched request type":   {tesrpc.TaskService_GetTask_FullMethodName, &tes.CancelTaskRequest{Id: "task1"}},
+		"nil request":               {events.EventService_WriteEvent_FullMethodName, nil},
+	}
+	for name, c := range refused {
+		t.Run(name, func(t *testing.T) {
+			user, err := callInterceptor(auth, workerContext("task1"), c)
+			if status.Code(err) != codes.PermissionDenied || user != nil {
+				t.Fatalf("user=%v err=%v; want PermissionDenied", user, err)
+			}
+		})
+	}
+	// The job service credential keeps its access.
+	for name, c := range refused {
+		if strings.Contains(name, "node") || name == "unknown method" || name == "mismatched request type" || name == "nil request" {
+			continue
+		}
+		user, err := callInterceptor(auth, basicContext("jobsvc", "synthetic"), c)
+		if err != nil || user == nil || user.Username != "jobsvc" || !user.IsAdmin {
+			t.Fatalf("job service %s: user=%v err=%v", name, user, err)
+		}
+	}
+}
+
+func TestTaskWorkerCredentialAuthentication(t *testing.T) {
+	get := call{tesrpc.TaskService_GetTask_FullMethodName, &tes.GetTaskRequest{Id: "task1"}}
+	otherKey := []byte("fedcba9876543210fedcba9876543210")
+	password := taskcred.Password(workerKey, "task1")
+
+	withKey := NewAuthentication([]*config.BasicCredential{{User: "jobsvc", Password: "synthetic", Admin: true}}, nil, identity.AccessAll, nil)
+	withKey.EnableTaskCredentials(workerKey)
+	cases := map[string]context.Context{
+		"other task's password": basicContext("task/task1", taskcred.Password(workerKey, "task2")),
+		"other key":             basicContext("task/task1", taskcred.Password(otherKey, "task1")),
+		"no task prefix":        basicContext("task1", password),
+		"wrong password":        basicContext("task/task1", taskcred.Password(workerKey, "task1x")),
+		"no colon":              metadata.NewIncomingContext(context.Background(), metadata.Pairs("authorization", "Basic "+base64.StdEncoding.EncodeToString([]byte("task/task1")))),
+		"not base64":            metadata.NewIncomingContext(context.Background(), metadata.Pairs("authorization", "Basic %%%")),
+		"bearer":                metadata.NewIncomingContext(context.Background(), metadata.Pairs("authorization", "Bearer "+password)),
+	}
+	for name, ctx := range cases {
+		t.Run(name, func(t *testing.T) {
+			user, err := callInterceptor(withKey, ctx, get)
+			if status.Code(err) != codes.Unauthenticated || user != nil {
+				t.Fatalf("user=%v err=%v; want Unauthenticated", user, err)
+			}
+		})
+	}
+
+	// Without a key, worker credentials are not accepted and do not open public access.
+	withoutKey := NewAuthentication([]*config.BasicCredential{{User: "jobsvc", Password: "synthetic", Admin: true}}, nil, identity.AccessAll, nil)
+	if user, err := callInterceptor(withoutKey, workerContext("task1"), get); status.Code(err) != codes.Unauthenticated || user != nil {
+		t.Fatalf("without key: user=%v err=%v", user, err)
+	}
+
+	// A key alone enables authentication: requests without credentials are refused.
+	keyOnly := NewAuthentication(nil, nil, identity.AccessAll, nil)
+	keyOnly.EnableTaskCredentials(workerKey)
+	if user, err := callInterceptor(keyOnly, context.Background(), get); err == nil || user != nil {
+		t.Fatalf("key only, no credential: user=%v err=%v", user, err)
+	}
+	if user, err := callInterceptor(keyOnly, workerContext("task1"), get); err != nil || user.Username != "task/task1" {
+		t.Fatalf("key only, worker credential: user=%v err=%v", user, err)
+	}
+}
