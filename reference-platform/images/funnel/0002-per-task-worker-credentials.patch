index 0000000..a7a3c99
--- /dev/null
+++ b/internal/server/task_worker_integration_test.go
@@ -0,0 +1,211 @@
+package server
+
+import (
+	"context"
+	"encoding/base64"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/grpc/status"
+
+	"github.com/calypr/funnel/api/config"
+	"github.com/calypr/funnel/api/tes"
+	appconfig "github.com/calypr/funnel/internal/config"
+	"github.com/calypr/funnel/internal/database/boltdb"
+	"github.com/calypr/funnel/internal/events"
+	"github.com/calypr/funnel/internal/identity"
+	"github.com/calypr/funnel/internal/server/taskservice"
+	"github.com/calypr/funnel/internal/taskcred"
+	"github.com/calypr/funnel/internal/tesrpc"
+)
+
+// TestTaskWorkerCredentialOverGRPCAndHTTP checks a per-task worker credential
+// against a running server, through gRPC and through the HTTP gateway.
+func TestTaskWorkerCredentialOverGRPCAndHTTP(t *testing.T) {
+	dir := t.TempDir()
+	key := []byte("0123456789abcdef0123456789abcdef")
+	keyFile := filepath.Join(dir, "worker-key")
+	if err := os.WriteFile(keyFile, append(key, '\n'), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	db, err := boltdb.NewBoltDB(&config.BoltDB{Path: filepath.Join(dir, "tasks.db")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(db.Close)
+	if err := db.Init(); err != nil {
+		t.Fatal(err)
+	}
+	owner := identity.WithUser(context.Background(), &identity.UserInfo{Username: "jobsvc"})
+	for _, id := range []string{"task1", "task2"} {
+		if err := db.WriteEvent(owner, events.NewTaskCreated(&tes.Task{Id: id, State: tes.Queued})); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	rpcAddress := freeTCPAddress(t)
+	httpPort := strconv.Itoa(tcpPort(t))
+	s := newTestServer(rpcAddress, httpPort)
+	s.Tasks = &taskservice.Service{Read: db, Log: s.Log, Config: appconfig.DefaultConfig()}
+	s.Events = &events.Service{Writer: db, Claimer: db}
+	s.TaskAccess = identity.AccessOwnerOrAdmin
+	s.BasicAuth = []*config.BasicCredential{{User: "jobsvc", Password: "synthetic", Admin: true}}
+	s.WorkerCredentialKeyFile = keyFile
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { done <- s.Serve(ctx) }()
+	httpClient := &http.Client{Timeout: 5 * time.Second, Transport: &http.Transport{}}
+	t.Cleanup(func() {
+		httpClient.CloseIdleConnections()
+		cancel()
+		select {
+		case err := <-done:
+			if err != nil {
+				t.Errorf("server stopped: %v", err)
+			}
+		case <-time.After(10 * time.Second):
+			t.Error("server did not stop")
+		}
+	})
+
+	conn, err := grpc.NewClient(rpcAddress, grpc.WithTransportCredentials(insecure.NewCredentials()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := conn.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	worker := "Basic " + base64.StdEncoding.EncodeToString([]byte(taskcred.Credential(key, "task1")))
+	jobsvc := "Basic " + base64.StdEncoding.EncodeToString([]byte("jobsvc:synthetic"))
+	tasks := tesrpc.NewTaskServiceClient(conn)
+	eventClient := events.NewEventServiceClient(conn)
+	rpc := func(authorization string, call func(context.Context) error) error {
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		return call(metadata.NewOutgoingContext(ctx, metadata.Pairs("authorization", authorization)))
+	}
+	ready := grpc.WaitForReady(true)
+
+	grpcCases := []struct {
+		name string
+		want codes.Code
+		call func(context.Context) error
+	}{
+		{"get own task", codes.OK, func(ctx context.Context) error {
+			_, err := tasks.GetTask(ctx, &tes.GetTaskRequest{Id: "task1", View: "FULL"}, ready)
+			return err
+		}},
+		{"claim own task", codes.OK, func(ctx context.Context) error {
+			_, err := eventClient.ClaimExecution(ctx, &events.ClaimExecutionRequest{TaskId: "task1"}, ready)
+			return err
+		}},
+		{"system log to own task", codes.OK, func(ctx context.Context) error {
+			_, err := eventClient.WriteEvent(ctx, events.NewSystemLog("task1", 0, 0, "info", "own", nil), ready)
+			return err
+		}},
+		{"list tasks", codes.PermissionDenied, func(ctx context.Context) error {
+			_, err := tasks.ListTasks(ctx, &tes.ListTasksRequest{View: "FULL"}, ready)
+			return err
+		}},
+		{"create task", codes.PermissionDenied, func(ctx context.Context) error {
+			_, err := tasks.CreateTask(ctx, &tes.Task{Executors: []*tes.Executor{{Image: "alpine", Command: []string{"true"}}}}, ready)
+			return err
+		}},
+		{"cancel other task", codes.PermissionDenied, func(ctx context.Context) error {
+			_, err := tasks.CancelTask(ctx, &tes.CancelTaskRequest{Id: "task2"}, ready)
+			return err
+		}},
+		{"get other task", codes.PermissionDenied, func(ctx context.Context) error {
+			_, err := tasks.GetTask(ctx, &tes.GetTaskRequest{Id: "task2", View: "FULL"}, ready)
+			return err
+		}},
+		{"canceled event to other task", codes.PermissionDenied, func(ctx context.Context) error {
+			_, err := eventClient.WriteEvent(ctx, events.NewState("task2", tes.Canceled), ready)
+			return err
+		}},
+		{"claim other task", codes.PermissionDenied, func(ctx context.Context) error {
+			_, err := eventClient.ClaimExecution(ctx, &events.ClaimExecutionRequest{TaskId: "task2"}, ready)
+			return err
+		}},
+	}
+	for _, c := range grpcCases {
+		if err := rpc(worker, c.call); status.Code(err) != c.want {
+			t.Errorf("worker gRPC %s: %v, want %s", c.name, err, c.want)
+		}
+	}
+	if err := rpc(jobsvc, func(ctx context.Context) error {
+		_, err := tasks.ListTasks(ctx, &tes.ListTasksRequest{}, ready)
+		return err
+	}); err != nil {
+		t.Errorf("job service list: %v", err)
+	}
+
+	base := "http://127.0.0.1:" + httpPort
+	httpCases := []struct {
+		authorization, method, path, body string
+		want                              int
+	}{
+		{worker, http.MethodGet, "/v1/tasks/task1", "", http.StatusOK},
+		{worker, http.MethodGet, "/v1/tasks", "", http.StatusForbidden},
+		{worker, http.MethodGet, "/ga4gh/tes/v1/tasks", "", http.StatusForbidden},
+		{worker, http.MethodGet, "/v1/tasks/task2", "", http.StatusForbidden},
+		{worker, http.MethodPost, "/v1/tasks", `{"executors":[{"image":"alpine","command":["true"]}]}`, http.StatusForbidden},
+		{worker, http.MethodPost, "/v1/tasks/task2:cancel", "", http.StatusForbidden},
+		{worker, http.MethodPost, "/v1/tasks/task1:cancel", "", http.StatusForbidden},
+		{jobsvc, http.MethodGet, "/v1/tasks", "", http.StatusOK},
+		{jobsvc, http.MethodGet, "/v1/tasks/task2", "", http.StatusOK},
+	}
+	for _, c := range httpCases {
+		var status int
+		for deadline := time.Now().Add(5 * time.Second); ; {
+			req, err := http.NewRequest(c.method, base+c.path, strings.NewReader(c.body))
+			if err != nil {
+				t.Fatal(err)
+			}
+			req.Header.Set("Authorization", c.authorization)
+			req.Header.Set("Content-Type", "application/json")
+			resp, err := httpClient.Do(req)
+			if err == nil {
+				_, copyErr := io.Copy(io.Discard, resp.Body)
+				closeErr := resp.Body.Close()
+				if copyErr != nil || closeErr != nil {
+					t.Fatalf("HTTP %s %s: reading response: %v %v", c.method, c.path, copyErr, closeErr)
+				}
+				status = resp.StatusCode
+				break
+			}
+			if time.Now().After(deadline) {
+				t.Fatalf("HTTP %s %s: %v", c.method, c.path, err)
+			}
+			time.Sleep(25 * time.Millisecond)
+		}
+		if status != c.want {
+			t.Errorf("HTTP %s %s as %s: status %d, want %d", c.method, c.path, strings.SplitN(c.authorization, " ", 2)[0], status, c.want)
+		}
+	}
+
+	task2, err := db.GetTask(owner, &tes.GetTaskRequest{Id: "task2", View: "FULL"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if task2.State != tes.Queued {
+		t.Fatalf("other task changed state: %s", task2.State)
+	}
+	for _, log := range task2.Logs {
+		if len(log.SystemLogs) != 0 || len(log.Logs) != 0 {
+			t.Fatalf("other task received events: %v", task2.Logs)
+		}
+	}
+}
diff --git a/internal/taskcred/taskcred.go b/internal/taskcred/taskcred.go
new file mode 100644
index 0000000..c73cedb
--- /dev/null
+++ b/internal/taskcred/taskcred.go
@@ -0,0 +1,77 @@
+// Package taskcred derives and verifies worker credentials bound to one task.
+//
+// A credential is a Basic user "task/<id>" with a password that is an
+// HMAC-SHA256 of the task ID under a server key. Only holders of the key can
+// derive a password, and a password is valid for its own task ID only.
+package taskcred
+
+import (
+	"bytes"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/base64"
+	"fmt"
+	"os"
+	"strings"
+)
+
+// MinKeyBytes is the minimum key length.
+const MinKeyBytes = 32
+
+const (
+	userPrefix = "task/"
+	// domain separates these MACs from any other use of the key.
+	domain = "funnel task worker credential v1\x00"
+)
+
+// LoadKey reads a key file. A final line break is not part of the key.
+func LoadKey(path string) ([]byte, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("reading worker credential key: %w", err)
+	}
+	key := bytes.TrimRight(data, "\r\n")
+	if len(key) < MinKeyBytes {
+		return nil, fmt.Errorf("worker credential key in %q must have at least %d bytes", path, MinKeyBytes)
+	}
+	return key, nil
+}
+
+// Username returns the Basic user of the credential for taskID.
+func Username(taskID string) string {
+	return userPrefix + taskID
+}
+
+// Password returns the Basic password of the credential for taskID.
+func Password(key []byte, taskID string) string {
+	return base64.RawURLEncoding.EncodeToString(mac(key, taskID))
+}
+
+// Credential returns the credential for taskID as "user:password".
+func Credential(key []byte, taskID string) string {
+	return Username(taskID) + ":" + Password(key, taskID)
+}
+
+// Verify checks a Basic user and password and returns the task ID the
+// credential is bound to. The MAC comparison takes constant time.
+func Verify(key []byte, user, password string) (string, bool) {
+	taskID, ok := strings.CutPrefix(user, userPrefix)
+	if len(key) == 0 || !ok || taskID == "" {
+		return "", false
+	}
+	got, err := base64.RawURLEncoding.Strict().DecodeString(password)
+	if err != nil {
+		return "", false
+	}
+	if !hmac.Equal(got, mac(key, taskID)) {
+		return "", false
+	}
+	return taskID, true
+}
+
+func mac(key []byte, taskID string) []byte {
+	m := hmac.New(sha256.New, key)
+	m.Write([]byte(domain))
+	m.Write([]byte(taskID))
+	return m.Sum(nil)
+}
diff --git a/internal/taskcred/taskcred_test.go b/internal/taskcred/taskcred_test.go
new file mode 100644
index 0000000..b260577
--- /dev/null
+++ b/internal/taskcred/taskcred_test.go
@@ -0,0 +1,76 @@
+package taskcred
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+var testKey = []byte("0123456789abcdef0123456789abcdef")
+
+func TestVerify(t *testing.T) {
+	password := Password(testKey, "task1")
+	if id, ok := Verify(testKey, Username("task1"), password); !ok || id != "task1" {
+		t.Fatalf("Verify of a derived credential = %q, %v", id, ok)
+	}
+	if got := Credential(testKey, "task1"); got != "task/task1:"+password {
+		t.Fatalf("Credential = %q", got)
+	}
+
+	// The last character carries two padding bits; only the canonical encoding verifies.
+	const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
+	last := strings.IndexByte(alphabet, password[len(password)-1])
+	nonCanonical := password[:len(password)-1] + string(alphabet[last^1])
+
+	otherKey := []byte("fedcba9876543210fedcba9876543210")
+	cases := map[string]struct {
+		key            []byte
+		user, password string
+	}{
+		"other task":        {testKey, Username("task2"), password},
+		"other key":         {otherKey, Username("task1"), password},
+		"no key":            {nil, Username("task1"), password},
+		"no prefix":         {testKey, "task1", password},
+		"empty task":        {testKey, Username(""), Password(testKey, "")},
+		"truncated":         {testKey, Username("task1"), password[:len(password)-2]},
+		"padded encoding":   {testKey, Username("task1"), password + "="},
+		"not base64":        {testKey, Username("task1"), "!" + password[1:]},
+		"empty password":    {testKey, Username("task1"), ""},
+		"non-canonical":     {testKey, Username("task1"), nonCanonical},
+		"task id extension": {testKey, Username("task1x"), password},
+	}
+	for name, c := range cases {
+		t.Run(name, func(t *testing.T) {
+			if id, ok := Verify(c.key, c.user, c.password); ok || id != "" {
+				t.Fatalf("Verify = %q, %v; want refusal", id, ok)
+			}
+		})
+	}
+}
+
+func TestLoadKey(t *testing.T) {
+	dir := t.TempDir()
+	write := func(name, content string) string {
+		path := filepath.Join(dir, name)
+		if err := os.WriteFile(path, []byte(content), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		return path
+	}
+
+	key, err := LoadKey(write("ok", string(testKey)+"\n"))
+	if err != nil || string(key) != string(testKey) {
+		t.Fatalf("LoadKey = %q, %v", key, err)
+	}
+	if _, err := LoadKey(write("short", strings.Repeat("k", MinKeyBytes-1)+"\n")); err == nil {
+		t.Fatal("LoadKey accepted a short key")
+	}
+	key, err = LoadKey(write("crlf", " "+string(testKey)+"\r\n"))
+	if err != nil || string(key) != " "+string(testKey) {
+		t.Fatalf("LoadKey kept or trimmed the wrong bytes: %q, %v", key, err)
+	}
+	if _, err := LoadKey(filepath.Join(dir, "missing")); err == nil {
+		t.Fatal("LoadKey accepted a missing file")
+	}
+}
