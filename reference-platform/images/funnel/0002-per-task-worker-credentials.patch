+// credential returns the Basic credential from RPCClient.CredentialFile or,
+// without one, from RPCClient.Credential.
+func credential(conf *config.RPCClient) (string, string, error) {
+	user, password := conf.GetCredential().GetUser(), conf.GetCredential().GetPassword()
+	path := conf.GetCredentialFile()
+	if path == "" {
+		return user, password, nil
+	}
+	if user != "" || password != "" {
+		return "", "", fmt.Errorf("rpc: set either RPCClient.Credential or RPCClient.CredentialFile, not both")
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return "", "", fmt.Errorf("rpc: reading RPCClient.CredentialFile: %w", err)
+	}
+	user, password, ok := strings.Cut(strings.TrimRight(string(data), "\r\n"), ":")
+	if !ok || user == "" || password == "" {
+		return "", "", fmt.Errorf("rpc: RPCClient.CredentialFile %q must contain user:password", path)
+	}
+	return user, password, nil
+}
