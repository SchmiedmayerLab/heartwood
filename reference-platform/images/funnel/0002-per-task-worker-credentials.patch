@@ -0,0 +1,61 @@
+package rpcclient
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/calypr/funnel/api/config"
+)
+
+func TestCredentialFile(t *testing.T) {
+	dir := t.TempDir()
+	write := func(name, content string) string {
+		path := filepath.Join(dir, name)
+		if err := os.WriteFile(path, []byte(content), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		return path
+	}
+
+	user, password, err := credential(&config.RPCClient{CredentialFile: write("ok", "task/abc:pass:word\n")})
+	if err != nil || user != "task/abc" || password != "pass:word" {
+		t.Fatalf("credential = %q, %q, %v", user, password, err)
+	}
+	user, password, err = credential(&config.RPCClient{Credential: &config.BasicCredential{User: "u", Password: "p"}})
+	if err != nil || user != "u" || password != "p" {
+		t.Fatalf("inline credential = %q, %q, %v", user, password, err)
+	}
+
+	for name, conf := range map[string]*config.RPCClient{
+		"both":          {CredentialFile: write("both", "u:p"), Credential: &config.BasicCredential{User: "u"}},
+		"missing file":  {CredentialFile: filepath.Join(dir, "missing")},
+		"no colon":      {CredentialFile: write("nocolon", "user")},
+		"empty user":    {CredentialFile: write("nouser", ":p")},
+		"empty secret":  {CredentialFile: write("nopassword", "u:\n")},
+		"empty content": {CredentialFile: write("empty", "")},
+	} {
+		if _, _, err := credential(conf); err == nil {
+			t.Errorf("%s: accepted", name)
+		}
+	}
+}
+
+func TestDialRejectsRemotePlaintextCredentialFile(t *testing.T) {
+	t.Setenv("FUNNEL_ALLOW_INSECURE_CREDENTIALS", "")
+	path := filepath.Join(t.TempDir(), "credential")
+	if err := os.WriteFile(path, []byte("task/abc:secret"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	conn, err := Dial(context.Background(), &config.RPCClient{ServerAddress: "remote.invalid:9090", CredentialFile: path})
+	if conn != nil {
+		if closeErr := conn.Close(); closeErr != nil {
+			t.Fatal(closeErr)
+		}
+	}
+	if err == nil || !strings.Contains(err.Error(), "refusing credentials over remote plaintext") {
+		t.Fatalf("Dial = %v; want refusal", err)
+	}
+}
