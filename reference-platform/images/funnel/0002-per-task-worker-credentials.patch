+apiVersion: batch/v1
+kind: Job
+metadata:
+  name: {{.TaskId}}
+  namespace: {{.JobsNamespace}}
+spec:
+  template:
+    spec:
+      restartPolicy: Never
+      containers:
+      - name: worker
+        image: worker
+        volumeMounts:
+        - {name: credential, mountPath: /etc/funnel-task, readOnly: true}
+      volumes:
+      - name: credential
+        secret: {secretName: "{{.WorkerCredentialSecret}}"}
+`
+
+func TestWorkerCredentialSecretLifecycle(t *testing.T) {
+	key := []byte("0123456789abcdef0123456789abcdef")
+	for _, enabled := range []bool{true, false} {
+		client := fake.NewSimpleClientset()
+		conf := appconfig.DefaultConfig()
+		conf.Kubernetes.Namespace = "ns"
+		conf.Kubernetes.JobsNamespace = "ns"
+		conf.Kubernetes.WorkerTemplate = credentialWorkerTemplate
+		log := logger.NewLogger("test", logger.DefaultConfig())
+		log.Discard()
+		backend := &Backend{client: client, event: &noopEventWriter{}, log: log, conf: conf}
+		if enabled {
+			backend.taskKey = key
+			conf.Server.WorkerCredentialKeyFile = "/etc/funnel/worker-key"
+		}
+		ctx := context.Background()
+		task := &tes.Task{Id: "task1", Executors: []*tes.Executor{{Image: "alpine", Command: []string{"true"}}}}
+		if err := backend.Submit(ctx, task, conf); err != nil {
+			t.Fatal(err)
+		}
+		name := resources.WorkerCredentialSecretName(task.Id)
+		secret, err := client.CoreV1().Secrets("ns").Get(ctx, name, metav1.GetOptions{})
+		if !enabled {
+			if err == nil {
+				t.Fatal("Secret created without a worker credential key")
+			}
+			continue
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		credential := secret.StringData[resources.WorkerCredentialKey]
+		user, password, _ := strings.Cut(credential, ":")
+		if id, ok := taskcred.Verify(key, user, password); !ok || id != task.Id {
+			t.Fatalf("Secret credential verifies as %q, %v", id, ok)
+		}
+		job, err := client.BatchV1().Jobs("ns").Get(ctx, task.Id, metav1.GetOptions{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(secret.OwnerReferences) != 1 || secret.OwnerReferences[0].Name != job.Name || secret.OwnerReferences[0].Kind != "Job" {
+			t.Fatalf("Secret owner references: %v", secret.OwnerReferences)
+		}
+		if secret.Immutable == nil || !*secret.Immutable {
+			t.Fatal("Secret is mutable")
+		}
+		spec, err := json.Marshal(job)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if strings.Contains(string(spec), password) {
+			t.Fatal("Job spec contains the worker password")
+		}
+		if got := job.Spec.Template.Spec.Volumes[0].Secret.SecretName; got != name {
+			t.Fatalf("template rendered Secret name %q, want %q", got, name)
+		}
+
+		if err := backend.cleanResources(ctx, task.Id); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := client.CoreV1().Secrets("ns").Get(ctx, name, metav1.GetOptions{}); err == nil {
+			t.Fatal("Secret remains after cleanup")
+		}
+		// Cleanup of an already removed Secret succeeds.
+		if err := backend.cleanResources(ctx, task.Id); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func credentialBackend(t *testing.T) (*Backend, *fake.Clientset, *config.Config) {
+	t.Helper()
+	client := fake.NewSimpleClientset()
+	conf := appconfig.DefaultConfig()
+	conf.Kubernetes.Namespace = "ns"
+	conf.Kubernetes.JobsNamespace = "ns"
+	conf.Kubernetes.WorkerTemplate = credentialWorkerTemplate
+	conf.Server.WorkerCredentialKeyFile = "/etc/funnel/worker-key"
+	log := logger.NewLogger("test", logger.DefaultConfig())
+	log.Discard()
+	backend := &Backend{client: client, event: &noopEventWriter{}, log: log, conf: conf, taskKey: []byte("0123456789abcdef0123456789abcdef")}
+	return backend, client, conf
+}
+
+func TestWorkerCredentialSecretFailureRollsBackJob(t *testing.T) {
+	backend, client, conf := credentialBackend(t)
+	client.PrependReactor("create", "secrets", func(k8stesting.Action) (bool, runtime.Object, error) {
+		return true, nil, errors.New("synthetic Secret failure")
+	})
+	ctx := context.Background()
+	task := &tes.Task{Id: "task1", Executors: []*tes.Executor{{Image: "alpine", Command: []string{"true"}}}}
+	if err := backend.Submit(ctx, task, conf); err == nil || !strings.Contains(err.Error(), "synthetic Secret failure") {
+		t.Fatalf("Submit = %v; want the Secret failure", err)
+	}
+	if _, err := client.BatchV1().Jobs("ns").Get(ctx, task.Id, metav1.GetOptions{}); err == nil {
+		t.Fatal("worker Job remains after the Secret failed")
+	}
+}
+
+func TestWorkerCredentialSecretRemovedOnCancelEvent(t *testing.T) {
+	backend, client, conf := credentialBackend(t)
+	ctx := context.Background()
+	task := &tes.Task{Id: "task1", Executors: []*tes.Executor{{Image: "alpine", Command: []string{"true"}}}}
+	if err := backend.Submit(ctx, task, conf); err != nil {
+		t.Fatal(err)
+	}
+	name := resources.WorkerCredentialSecretName(task.Id)
+	if _, err := client.CoreV1().Secrets("ns").Get(ctx, name, metav1.GetOptions{}); err != nil {
+		t.Fatal(err)
+	}
+	if err := backend.WriteEvent(ctx, events.NewState(task.Id, tes.Canceled)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := client.CoreV1().Secrets("ns").Get(ctx, name, metav1.GetOptions{}); err == nil {
+		t.Fatal("Secret remains after cancellation")
+	}
+}
+
+func TestWorkerCredentialKeyRefusesPerTaskConfigMap(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "key")
+	if err := os.WriteFile(path, []byte("0123456789abcdef0123456789abcdef\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	conf := appconfig.DefaultConfig()
+	conf.Kubernetes.Namespace = "ns"
+	conf.Kubernetes.WorkerTemplate = credentialWorkerTemplate
+	conf.Kubernetes.ConfigMapTemplate = configMapTemplate
+	conf.Kubernetes.DisableReconciler = true
+	conf.Server.WorkerCredentialKeyFile = path
+	_, err := NewBackend(context.Background(), conf, nil, &noopEventWriter{}, logger.NewLogger("test", logger.DefaultConfig()))
+	if err == nil || !strings.Contains(err.Error(), "ConfigMapTemplate") {
+		t.Fatalf("NewBackend = %v; want refusal of ConfigMapTemplate", err)
+	}
+}
+
+func TestWorkerCredentialPerTaskConfigurationRefused(t *testing.T) {
+	for name, change := range map[string]func(*config.Config){
+		"ConfigMapTemplate": func(c *config.Config) { c.Kubernetes.ConfigMapTemplate = configMapTemplate },
+		"key file":          func(c *config.Config) { c.Server.WorkerCredentialKeyFile = "" },
+	} {
+		t.Run(name, func(t *testing.T) {
+			backend, client, conf := credentialBackend(t)
+			taskConf := googleproto.Clone(conf).(*config.Config)
+			change(taskConf)
+			ctx := context.Background()
+			task := &tes.Task{Id: "task1", Executors: []*tes.Executor{{Image: "alpine", Command: []string{"true"}}}}
+			if err := backend.Submit(ctx, task, taskConf); err == nil {
+				t.Fatal("Submit accepted the per-task configuration")
+			}
+			jobs, err := client.BatchV1().Jobs("ns").List(ctx, metav1.ListOptions{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			maps, err := client.CoreV1().ConfigMaps("ns").List(ctx, metav1.ListOptions{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(jobs.Items) != 0 || len(maps.Items) != 0 {
+				t.Fatalf("resources left: %d Jobs, %d ConfigMaps", len(jobs.Items), len(maps.Items))
+			}
+		})
+	}
+}
