diff --git a/internal/compute/kubernetes/resources/secret.go b/internal/compute/kubernetes/resources/secret.go
new file mode 100644
index 0000000..0ff7b25
--- /dev/null
+++ b/internal/compute/kubernetes/resources/secret.go
@@ -0,0 +1,57 @@
+package resources
+
+import (
+	"context"
+	"fmt"
+
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/client-go/kubernetes"
+
+	"github.com/calypr/funnel/internal/logger"
+	"github.com/calypr/funnel/internal/taskcred"
+)
+
+// WorkerCredentialKey is the key of the credential in the per-task Secret.
+const WorkerCredentialKey = "credential"
+
+// WorkerCredentialSecretName returns the name of the per-task Secret that
+// holds the task's worker credential.
+func WorkerCredentialSecretName(taskID string) string {
+	return "funnel-worker-credential-" + taskID
+}
+
+// CreateWorkerCredentialSecret stores the worker credential of a task in its
+// own Secret, owned by the worker Job so that it is removed with the Job.
+func CreateWorkerCredentialSecret(ctx context.Context, taskID, namespace string, key []byte, client kubernetes.Interface, log *logger.Logger, ownerRef *metav1.OwnerReference) error {
+	immutable := true
+	secret := &corev1.Secret{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      WorkerCredentialSecretName(taskID),
+			Namespace: namespace,
+			Labels:    map[string]string{"app": "funnel-worker-credential", "taskId": taskID},
+		},
+		Immutable:  &immutable,
+		Type:       corev1.SecretTypeOpaque,
+		StringData: map[string]string{WorkerCredentialKey: taskcred.Credential(key, taskID)},
+	}
+	if ownerRef != nil {
+		secret.OwnerReferences = []metav1.OwnerReference{*ownerRef}
+	}
+	log.Debug("creating worker credential Secret", "taskID", taskID, "namespace", namespace)
+	if _, err := client.CoreV1().Secrets(namespace).Create(ctx, secret, metav1.CreateOptions{}); err != nil {
+		return err
+	}
+	return nil
+}
+
+// DeleteWorkerCredentialSecret deletes the per-task worker credential Secret.
+func DeleteWorkerCredentialSecret(ctx context.Context, taskID, namespace string, client kubernetes.Interface, log *logger.Logger) error {
+	log.Debug("deleting worker credential Secret", "taskID", taskID)
+	err := client.CoreV1().Secrets(namespace).Delete(ctx, WorkerCredentialSecretName(taskID), metav1.DeleteOptions{})
+	if err != nil && !errors.IsNotFound(err) {
+		return fmt.Errorf("deleting worker credential Secret: %w", err)
+	}
+	return nil
+}
